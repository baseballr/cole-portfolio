@page "/experience"
@inject IJSRuntime JS

<PageTitle>Experience — Cole Spitzer</PageTitle>

<section class="section">
    <h1>Cole Spitzer — Summary</h1>
    <p class="lead">I'm a software engineer with @YearsOfExperience() years of experience building production systems for government and insurance clients in C#, .NET, React, Azure, and SQL. At Deloitte I lead a five-developer team modernizing the platform Florida caseworkers use to process Medicaid, SNAP, and TANF applications. Before that, at Brown &amp; Brown, I built secure file sharing, compliance automation, and security reporting.
    </p>
    <p class="lead">I'm at my best on the hard, unglamorous problems: legacy databases I can't change, pipelines that have to move 108M+ rows in minutes, and systems that have to keep running while they're being replaced. I like understanding who will use what I build, and I take ownership from the first idea through production support. Open to remote roles or hybrid and on-site roles in Central Florida.
    </p>
</section>

<section class="section">
    <h2>Education</h2>
    <ul class="simple-list">
        <li><strong>B.S. Computer Science</strong>, Stetson University — July 2021</li>
        <li><strong>A.A. Degree</strong>, Daytona State College — May 2018</li>
    </ul>
</section>

<section class="section">
    <h2>Experience</h2>

    <div class="timeline">
        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>Solutions Specialist, Consultant</h3>
                <p class="timeline-meta">Deloitte (FLDCF) &middot; Remote &middot; April 2024 — Present</p>
                <p>
                    Lead a small team within a larger modernization program delivering a new React UI and backend APIs for a
                    government benefits platform. Work spans frontend, backend, and data integration with emphasis on reliability
                    and performance.
                </p>
                <ul>
                    <li>Lead a 5-developer team delivering UI features and integrations for a 200-person modernization program.</li>
                    <li>Developed 200+ C# APIs with sub-5-second responses using reusable async patterns to avoid duplicate work.</li>
                    <li>Built a data comparison ("wizards") tool that aggregates four government sources to help caseworkers process cases.</li>
                    <li>Designed workaround solutions for legacy databases to keep delivery on track when direct requests were infeasible.</li>
                    <li>Implemented a C# batch job that ingests and aggregates 108M+ rows into Excel workbooks and delivers them over SFTP in under 8 minutes.</li>
                </ul>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>Software Engineer</h3>
                <p class="timeline-meta">Brown &amp; Brown Insurance &middot; Hybrid (Daytona Beach, FL) &middot; October 2021 — April 2024</p>
                <p>
                    Worked on new features and modernization efforts across insurance systems, focusing on secure integrations,
                    automation, and internal tooling that reduced manual effort and improved operational visibility.
                </p>
                <ul>
                    <li>Built a secure Blazor file-sharing platform integrated with Entra External ID for internal and external users.</li>
                    <li>Developed a monthly legal survey system using Azure Functions, Azure Logic Apps, and .NET that sends 6,000+ timed reminder emails.</li>
                    <li>Created centralized REST APIs for authorization, PDF conversion, and OCR, managed through Azure API Management.</li>
                    <li>Built Power BI dashboards from Qualys data to surface vulnerability trends for security leaders.</li>
                    <li>Mentored and guided summer interns across five teams to help them deliver production-ready work.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <h2>Skills</h2>
    <div class="skills-grid">
        <div class="skill-card">
            <h3>Languages &amp; Frameworks</h3>
            <p>C#, .NET, Blazor, React, JavaScript, Python, Java, SQL</p>
        </div>
        <div class="skill-card">
            <h3>Cloud &amp; Tools</h3>
            <p>Azure Functions, Azure Web Apps, API Management, Azure Blobs, MSSQL, Oracle, Power BI, Docker, Git</p>
        </div>
        <div class="skill-card">
            <h3>Other</h3>
            <p>Entra ID, Swagger/OpenAPI, RESTful APIs, Power Platform, Visual Studio, VS Code, SurveyJS</p>
        </div>
    </div>
</section>

<section class="section">
    <h2>Community</h2>
    <ul class="simple-list">
        <li><strong>Assistant Youth Director</strong> &middot; September 2021 — Present</li>
        <li><strong>Board of Trustees member</strong>, First Church DeLand &middot; January 2023 — Present</li>
        <li><strong>Puppy trainer</strong>, Southeastern Guide Dogs &middot; December 2018 — January 2020</li>
    </ul>
</section>

@code {
    // First software engineering role started October 2021.
    private static int YearsOfExperience()
    {
        var today = DateTime.Today;
        return today.Year - 2021 - (today.Month < 10 ? 1 : 0);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("scrollRevealInterop.init");
        }
    }
}
