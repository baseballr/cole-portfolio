@code{
    private int yearsOfExperience()
    {
        DateTime startDate = new DateTime(2021, 10, 1);
        DateTime today = DateTime.Now;

        int _yearsOfExperience = today.Year - startDate.Year;
        if(today.Month < startDate.Month)
        {
            _yearsOfExperience--;
        }
        return _yearsOfExperience;
    }

}

