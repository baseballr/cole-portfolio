@page "/"

<PageTitle>Cole — Software Engineer</PageTitle>

<section class="hero">
    <HeroCarousel Images="_heroImages" IntervalMs="5000" />
    <div class="hero-content">
        <p class="eyebrow">Hi, I'm</p>
        <h1>Cole</h1>
        <p class="hero-subtitle">Software Engineer building enterprise applications with .NET, C#, React, and Azure.</p>
        <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">View Projects</a>
            <a href="/contact" class="btn btn-secondary">Get in Touch</a>
        </div>
    </div>
</section>

<section class="section">
    <h2>About Me</h2>
    <p>
        I'm a software engineer with nearly five years of experience designing and building enterprise
        applications. I currently work on a large government engagement, where I build and maintain
        systems using C#/.NET on the backend and React on the frontend, hosted on Azure with SQL Server
        for data storage.
    </p>
    <p>
        I'm passionate about writing clean, maintainable code and building applications that solve real
        problems for real users. I'm always looking to grow — whether that's picking up new frameworks,
        refining my architecture skills, or taking on more ownership within a team.
    </p>
</section>

<section class="section">
    <h2>Core Skills</h2>
    <div class="skills-grid">
        <div class="skill-card">
            <h3>Backend</h3>
            <p>C#, .NET, ASP.NET Core, RESTful APIs, SQL Server</p>
        </div>
        <div class="skill-card">
            <h3>Frontend</h3>
            <p>React, JavaScript/TypeScript, Blazor, HTML/CSS</p>
        </div>
        <div class="skill-card">
            <h3>Cloud &amp; DevOps</h3>
            <p>Microsoft Azure, CI/CD pipelines, Git</p>
        </div>
        <div class="skill-card">
            <h3>Practices</h3>
            <p>Enterprise application design, agile development, code review</p>
        </div>
    </div>
</section>

@code {
    // Drop your own photos in wwwroot/images/carousel/ and list them here, in order.
    private List<string> _heroImages = new()
    {
        "images/carousel/slide-1.jpg",
        "images/carousel/slide-2.jpg",
        "images/carousel/slide-3.jpg",
        "images/carousel/IMG_0273.jpg"
    };
}
