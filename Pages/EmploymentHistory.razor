@page "/employmenthistory"
@inject IJSRuntime JS

<section class="section">
    <h2>Employment Timeline</h2>

    <div class="timeline">
        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>Solutions Specialist, Consultant</h3>
                <p class="timeline-meta">Deloitte (FLDCF) &middot; Remote &middot; April 2024 — Present</p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>Software Engineer</h3>
                <p class="timeline-meta">Brown &amp; Brown Insurance &middot; Hybrid (Daytona Beach, FL) &middot; October 2021 — April 2024</p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>IT Resource Specialist</h3>
                <p class="timeline-meta">Stetson University &middot; DeLand, FL &middot; May 2021 - October 2021</p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>Lead IT Intern Resource Assistant</h3>
                <p class="timeline-meta">Stetson University &middot; DeLand, FL &middot; August 2020 - May 2021 </p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>Intern IT Resource Assistant</h3>
                <p class="timeline-meta">Stetson University &middot; DeLand, FL &middot; September 2019 - May 2020</p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>HVAC Assistant</h3>
                <p class="timeline-meta">Del-Air &middot; Sanford, FL &middot; May 2020 - August 2020</p>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <h3>Fleet Mechanic</h3>
                <p class="timeline-meta"> Del Air &middot; Sanford, FL &middot; May 2016 – Dec 2019</p>
            </div>
        </div>

    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("scrollRevealInterop.init");
        }
    }
}