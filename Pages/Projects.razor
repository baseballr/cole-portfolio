@page "/projects"

<PageTitle>Projects — Cole</PageTitle>

<section class="section">
    <h1>Projects</h1>
    <p class="section-intro">
        A few things I've built. Replace these placeholder cards with your own projects —
        each one below is meant to be swapped out.
    </p>

    <div class="projects-grid">
        <div class="project-card">
            <h3>Project Name</h3>
            <p>
                One or two sentences describing what this project does and what problem it solves.
            </p>
            <div class="tags">
                <span class="tag">C#</span>
                <span class="tag">.NET</span>
                <span class="tag">Azure</span>
            </div>
            <div class="project-links">
                <a href="#" class="link">Live Demo</a>
                <a href="#" class="link">Source</a>
            </div>
        </div>

        <div class="project-card">
            <h3>Project Name</h3>
            <p>
                One or two sentences describing what this project does and what problem it solves.
            </p>
            <div class="tags">
                <span class="tag">React</span>
                <span class="tag">TypeScript</span>
            </div>
            <div class="project-links">
                <a href="#" class="link">Live Demo</a>
                <a href="#" class="link">Source</a>
            </div>
        </div>

        <div class="project-card">
            <h3>Project Name</h3>
            <p>
                One or two sentences describing what this project does and what problem it solves.
            </p>
            <div class="tags">
                <span class="tag">SQL</span>
                <span class="tag">Blazor</span>
            </div>
            <div class="project-links">
                <a href="#" class="link">Live Demo</a>
                <a href="#" class="link">Source</a>
            </div>
        </div>
    </div>
</section>
