@page "/about"

<PageTitle>Cole Spitzer — Software Engineer</PageTitle>

<section class="hero">
    <HeroCarousel Images="_heroImages" />
    <div class="hero-content">
        <p class="eyebrow">Hi, I'm</p>
        <h1>Cole</h1>
        <p class="hero-subtitle">Software Engineer building enterprise applications with .NET, C#, React, and Azure.</p>
        <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">View Projects</a>
            <a href="/contact" class="btn btn-secondary">Get in Touch</a>
        </div>
    </div>
</section>

<section class="section">
    <h2>About Me</h2>

    <p>
        I’m @CurrentAge(), I live in Central Florida, and I like figuring out how things work, whether that’s a legacy system nobody wants to touch or the wiring in my own house.
        I can be a little stubborn (I prefer “persistent”). When a problem catches my interest, I stay with it until I understand it. When FLDCF needed 108M+ rows of data in Excel, which caps how many rows a workbook can hold, I didn’t push back on the format; I built a job that splits the data across workbooks automatically and still finishes in under eight minutes.
    </p>
    <p>
        When I’m not working, I’m usually outdoors: skiing mountains along the East Coast, racing my dirt bike, camping, or out on the water. I bought my first home in 2025 and have been taking on the electrical work, landscaping, and building projects myself.
        I also serve as an assistant youth director and on the board of trustees at my church. If you want the fun version of all this, <a href="/colesworld">take a drive through Cole’s World</a>.
    </p>
</section>

<section class="section">
    <h2>Core Skills</h2>
    <div class="skills-grid">
        <div class="skill-card">
            <h3>Backend</h3>
            <p>C#, .NET, ASP.NET Core, RESTful APIs, MSSQL, Oracle</p>
        </div>
        <div class="skill-card">
            <h3>Frontend</h3>
            <p>React, JavaScript/TypeScript, Blazor, HTML/CSS</p>
        </div>
        <div class="skill-card">
            <h3>Cloud &amp; DevOps</h3>
            <p>Microsoft Azure, CI/CD pipelines, Git, Azure DevOps, Data Factory</p>
        </div>
        <div class="skill-card">
            <h3>Practices</h3>
            <p>Enterprise application design, agile development, code reviews, team leadership, MVC</p>
        </div>
    </div>
</section>

@code {
    private List<string> _heroImages = new()
    {
        "images/carousel/Cole3.jpg",
        "images/carousel/IMG_3337.jpg",
        "images/carousel/IMG_3386.jpg",
        "images/carousel/IMG_3403.jpg",
        "images/carousel/Cole1.jpg",
        "images/carousel/Cole2.jpg",
        "images/carousel/cole4.jpg",
    };

    // Born January 3, 2000.
    private static int CurrentAge()
    {
        var today = DateTime.Today;
        return today.Year - 2000 - (today < new DateTime(today.Year, 1, 3) ? 1 : 0);
    }
}
