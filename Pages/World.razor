            @foreach (var item in _scenery)
            {
                <span class="scenery scenery-@item.Kind" style="left:@($"{item.X}px"); top:@($"{item.Y}px")"></span>
            }

            @foreach (var location in _locations)
            {
                <button class="world-location @(IsNearby(location) ? "location-nearby" : string.Empty) @(ActiveLocation?.Id == location.Id ? "location-active" : string.Empty)" style="left:@($"{location.X}px"); top:@($"{location.Y}px")" @onclick="() => Inspect(location)" aria-label="Inspect @location.Name">
                    <span class="location-building location-building-@location.Id">@if (_season == "christmas" && location.Id is "home" or "work" or "ski" or "church") { <span class="xmas-lights"></span> }</span>
                    <span class="location-name">@location.Name</span>
                </button>
            }

            <div class="world-shade"></div>
            @foreach (var (x, y) in _fireflies)
            {
                <i class="firefly" style="left:@($"{x}px"); top:@($"{y}px")"></i>
            }
            @foreach (var puff in _dust)
            {
                <i @key="puff.Id" class="dust-puff" style="left:@($"{puff.X}px"); top:@($"{puff.Y}px")"></i>
            }
            @if (_honking)
            {
                <span class="speech speech-honk" style="left:@($"{_playerX}px"); top:@($"{_playerY}px")">HONK!</span>
            }

            <div class="world-truck world-truck-@Vehicle.Id" style="@TruckStyle" aria-label="Your @Vehicle.Name" @onpointerdown="StartDrag" @onpointermove="Drag" @onpointerup="StopDrag" @onpointercancel="StopDrag">
                <span class="truck-body"><span class="truck-bed"></span><span class="truck-cab"></span><span class="truck-hood"></span></span><i class="truck-wheel wheel-front"></i><i class="truck-wheel wheel-back"></i>
            </div>
        </div>
        <div class="world-weather" aria-hidden="true"></div>
        @if (_season == "christmas")
        {
            <div class="sky-sleigh" aria-hidden="true">
                <svg viewBox="0 -4 160 48" width="160" height="48">
                    <path d="M60 22 L108 20 M60 22 L136 18" stroke="#8a5a3c" stroke-width="1" />
                    <g fill="#8a5a3c">
                        <ellipse cx="112" cy="24" rx="9" ry="4.5" /><rect x="104" y="26" width="2" height="8" /><rect x="118" y="26" width="2" height="8" /><ellipse cx="123" cy="18" rx="3.5" ry="3" /><path d="M117 22 L122 17" stroke="#8a5a3c" stroke-width="3" />
                        <ellipse cx="140" cy="22" rx="9" ry="4.5" /><rect x="132" y="24" width="2" height="8" /><rect x="146" y="24" width="2" height="8" /><ellipse cx="151" cy="16" rx="3.5" ry="3" /><path d="M145 20 L150 15" stroke="#8a5a3c" stroke-width="3" />
                    </g>
                    <path d="M122 15 l-2 -5 m2 5 l3 -5 M150 13 l-2 -5 m2 5 l3 -5" stroke="#6b4329" stroke-width="1.2" fill="none" /><circle cx="155" cy="16" r="1.6" fill="#e5484d" />
                    <circle cx="26" cy="16" r="6" fill="#8a5a3c" />
                    <circle cx="40" cy="16" r="7" fill="#d35f46" /><circle cx="40" cy="7" r="4" fill="#eab48c" /><path d="M36 8 Q40 15 44 8 Z" fill="#fff" /><path d="M36 5 L41 -1 L44 5 Z" fill="#d35f46" /><circle cx="41" cy="-1" r="1.2" fill="#fff" />
                    <path d="M8 26 Q8 36 20 36 H58 Q64 36 64 28 V20 H30 Q24 20 22 26 Z" fill="#d35f46" /><path d="M6 40 H60 Q66 40 66 35" stroke="#f6d18a" stroke-width="2" fill="none" />
                </svg>
            </div>
        }
        @if (_season == "halloween")
        {
            @for (var bat = 0; bat < 3; bat++)
            {
                <svg class="sky-bat" viewBox="0 0 40 16" width="34" height="14" aria-hidden="true"><path class="bat-wings" d="M20 8 C16 2 10 2 2 6 C7 7 9 9 10 12 C13 9 16 9 20 11 C24 9 27 9 30 12 C31 9 33 7 38 6 C30 2 24 2 20 8 Z" fill="#2a1d2e" /></svg>
            }
        }
    </div>

    @if (ActiveLocation is not null)
    {
        <aside class="world-panel" @onclick:stopPropagation="true">
            @if (ActiveLocation.Id == "work")
            {
                <div class="office-interior-screen">
                    <div class="office-topbar"><button @onclick="ClosePanel">← Back outside</button><span>SOFTWARE ENGINEERING / @(SelectedWorkStation is null ? "OFFICE FLOOR" : "CUBICLE")</span><strong>WORK // BUILDING 01</strong></div>
                    @if (SelectedWorkStation is null)
                    {
                        <div class="office-room">
                            <div class="office-sign"><span>COLE'S</span><strong>WORK</strong><small>SELECT A DOOR TO ENTER</small></div>
                            <div class="office-floor"></div>
                            <div class="office-doors">
                                @foreach (var station in _workStations)
                                {
                                    <button class="office-door" @onclick="() => SelectWorkStation(station)">
                                        <span class="door-number">0@(Array.IndexOf(_workStations, station) + 1)</span>
                                        <span class="door-screen">@station.Icon</span>
                                        <strong>@station.ShortName</strong>
                                        <small>@station.Company</small>
                                        <em>ENTER →</em>
                                    </button>
                                }
                            </div>
                            <p class="office-floor-note">A small office floor for the systems, people, and problems that shaped the work.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cubicle-inside">
                            <button class="inside-back" @onclick="ClearWorkStation">← OFFICE FLOOR</button>
                            <div class="cubicle-window"><span>NOW ENTERING</span><strong>@SelectedWorkStation.Company</strong><small>@SelectedWorkStation.Title</small></div>
                            <div class="inside-desk"><button class="inside-monitor" @onclick="ToggleProjectLog" aria-pressed="@(ShowProjectLog ? "true" : "false")"><span>@SelectedWorkStation.Icon</span><small>PROJECT LOG</small></button><div class="inside-keyboard"></div>@if (MemoriesFor(SelectedWorkStation.Id).FirstOrDefault() is { } framed) { <button class="inside-photo-frame" @onclick="ToggleTeamPhotos" aria-pressed="@(ShowTeamPhotos ? "true" : "false")"><img src="@framed.ImagePath" alt="" /><small>TEAM PHOTOS</small></button> }</div>
                            @if (ShowProjectLog)
                            {
                                <div class="project-log-desk">
                                    <div class="project-log-heading"><span>PROJECT LOG</span><strong>@SelectedWorkStation.Company</strong><small>Select a sheet to inspect the work.</small></div>
                                    <div class="project-papers">
                                        @foreach (var project in SelectedWorkStation.Projects)
                                        {
                                            <button class="project-paper @(SelectedProject?.Id == project.Id ? "paper-selected" : string.Empty)" @onclick="() => SelectProject(project)">
                                                <span class="paper-pin"></span><strong>@project.Title</strong><small>@project.Summary</small><em>@project.Technologies</em>
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (SelectedProject is not null)
                                {
                                    <article class="project-monitor-detail"><div class="monitor-detail-bar"><span></span><span></span><span></span><small>PROJECT LOG // @SelectedWorkStation.ShortName</small></div><div class="monitor-detail-screen"><span class="panel-category">PROJECT DETAIL</span><h2>@SelectedProject.Title</h2><p>@SelectedProject.Detail</p><span class="paper-tech">@SelectedProject.Technologies</span></div></article>
                                }
                            }
                            else if (ShowTeamPhotos)
                            {
                                <div class="garage-pegboard cubicle-pegboard">
                                    @foreach (var memory in MemoriesFor(SelectedWorkStation.Id))
                                    {
                                        <figure class="pinned-photo"><span class="paper-pin"></span><img src="@memory.ImagePath" alt="@memory.Alt" /><figcaption><strong>@memory.Caption</strong><small>@memory.Description</small></figcaption></figure>
                                    }
                                </div>
                            }
                            else
                            {
                                <article class="inside-data"><span class="panel-category">@SelectedWorkStation.Company</span><h1>@SelectedWorkStation.Title</h1><p>@SelectedWorkStation.Description</p><div class="inside-tech"><span>TECHNOLOGIES</span><div>@foreach (var technology in SelectedWorkStation.Technologies) { <b>@technology</b> }</div></div><p class="monitor-hint">Click the monitor to open the project log.</p></article>
                            }
                        </div>
                    }
                </div>
            }
            else if (ActiveLocation.Id is "fishing" or "camp" or "church" or "golf" or "ski")
            {
                <div class="life-interior-screen">
                    <div class="life-topbar"><button @onclick="ClosePanel">← Back outside</button><span>@ActiveLocation.Name / MEMORY ROOM</span><strong>COLE'S WORLD</strong></div>
                    <div class="life-scene life-scene-@ActiveLocation.Id">
                        <div class="life-scene-title"><span>@ActiveLocation.Category</span><h1>@ActiveLocation.Name</h1><small>@ActiveLocation.Subtitle</small></div>
                        <div class="life-set-piece life-set-piece-@ActiveLocation.Id" aria-hidden="true"></div>
                        @MemoryWall(ActiveLocation.Id)
                    </div>
                </div>
            }
            else
            {
                <div class="home-interior-screen">
                    <div class="office-topbar">@if (HomeRoom is null) { <button @onclick="ClosePanel">← Back outside</button> } else { <button @onclick="() => EnterHomeRoom(null)">← Front yard</button> }<span>HOME / @(HomeRoom switch { "garage" => "GARAGE", "house" => "INSIDE", _ => "FRONT YARD" })</span><strong>HOME BASE</strong></div>
                    @if (HomeRoom is null)
                    {
                        <div class="home-front">
                            <div class="home-front-title"><span>@ActiveLocation.Category</span><h1>@ActiveLocation.Name</h1><small>@ActiveLocation.Subtitle</small></div>
                            <div class="house-facade">
                                <div class="house-roof"></div>
                                <div class="house-wall">
                                    <span class="house-window" aria-hidden="true"></span>
                                    <button class="house-door" @onclick='() => EnterHomeRoom("house")'><span>FRONT DOOR</span></button>
                                    <button class="house-garage" @onclick='() => EnterHomeRoom("garage")'><span>GARAGE</span></button>
                                </div>
                            </div>
                            <p class="home-front-note">Bought my first home in 2025. Outside of software development, I spend a lot of time working on projects around the house, from electrical work and landscaping to building things in the yard.</p>
                        </div>
                    }
                    else
                    {
                        @if (HomeRoom == "house")
                        {
                            <div class="life-scene life-scene-house">
                                <div class="life-scene-title"><span>INSIDE THE HOUSE</span><h1>Home</h1><small>A few of the moments that made it home.</small></div>
                                @MemoryWall("house")
                            </div>
                        }
                        else
                        {
                            <div class="home-room home-room-garage">
                                <div class="garage-vehicles">
                                    @foreach (var vehicle in _garageVehicles)
                                    {
                                        <button class="garage-vehicle @(SelectedVehicle == vehicle.Id ? "garage-vehicle-selected" : string.Empty)" @onclick="() => SelectVehicle(vehicle.Id)"><span>@vehicle.Icon</span><strong>@vehicle.Name</strong></button>
                                    }
                                </div>
                                @if (SelectedVehicle is null)
                                {
                                    <p class="garage-hint">Pick a ride to see the pictures pinned to the pegboard.</p>
                                }
                                else
                                {
                                    <div class="garage-pegboard">
                                        @foreach (var memory in MemoriesFor(SelectedVehicle))
                                        {
                                            <figure class="pinned-photo"><span class="paper-pin"></span><img src="@memory.ImagePath" alt="@memory.Alt" /><figcaption><strong>@memory.Caption</strong><small>@memory.Description</small></figcaption></figure>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </aside>
    }

    @if (ShowMinimap)
    {
        <div class="world-minimap" @onclick:stopPropagation="true">
            <div class="minimap-title">MAP <button @onclick="ToggleMinimap" aria-label="Close map">×</button></div>
            <svg class="minimap-map" viewBox="0 0 1500 1500" role="img" aria-label="Map of Cole's World">
                <rect width="1500" height="1500" fill="#79b99d" />
                <polygon points="890,290 1130,-20 1370,290" fill="#6f9a8c" /><polygon points="1072,54 1130,-20 1188,54" fill="#f2ead0" />
                <polygon points="1120,330 1310,120 1500,330" fill="#587f73" /><polygon points="1264,170 1310,120 1356,170" fill="#f2ead0" />
                <path d="@RiverPath" fill="none" stroke="#5facc0" stroke-width="44" stroke-linecap="round" />
                <ellipse cx="1350" cy="1165" rx="220" ry="155" transform="rotate(-12 1350 1165)" fill="#5facc0" stroke="#e9dcb5" stroke-width="16" />
                @foreach (var tree in _scenery.Where(item => item.Kind is "oak" or "pine"))
                {
                    <circle cx="@tree.X" cy="@(tree.Y - 20)" r="18" fill="@(tree.Kind == "pine" ? "#225d4b" : "#2f806a")" />
                }
                @foreach (var road in _mapRoads)
                {
                    <rect x="@road.X" y="@road.Y" width="@road.W" height="@road.H" fill="#e9dcb5" stroke="#e9dcb5" stroke-width="28" />
                }
                @foreach (var road in _mapRoads)
                {
                    <rect x="@road.X" y="@road.Y" width="@road.W" height="@road.H" fill="#56635f" />
                }
