    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Moving between panel layers usually removes the button that was clicked, which drops focus to <body>
        // and the section stops hearing keys (ESC, WASD). Pull focus back whenever the layer changes.
        if (PanelLayer != _focusedLayer)
        {
            _focusedLayer = PanelLayer;
            await _screen.FocusAsync(preventScroll: true);
        }
        if (!firstRender) return;
        try
        {
            _showWelcome = await JS.InvokeAsync<string?>("localStorage.getItem", "world-welcomed") is null;
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "world-secrets");
            _secrets.UnionWith((saved ?? "").Split(',').Where(SecretNames.ContainsKey));
            if (_secrets.Count > 0 || _showWelcome) StateHasChanged();
        }
        catch (JSException) { } // storage blocked: secrets just won't persist
    }

    private async Task FindSecret(string id)
    {
        if (!_secrets.Add(id)) return;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "world-secrets", string.Join(",", _secrets)); }
        catch (JSException) { }
        await ShowToast($"{SecretNames[id]} Secrets found: {_secrets.Count}/{SecretNames.Count}");
    }

