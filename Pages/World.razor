    // Dust: a puff at the truck's old spot every other step; only the last few stay mounted while their CSS fade plays.
    private readonly Queue<(int Id, int X, int Y)> _dust = new();
    private int _dustId;
    private void KickUpDust()
    {
        if (++_dustId % 2 != 0) return;
        _dust.Enqueue((_dustId, _playerX, _playerY));
        if (_dust.Count > 6) _dust.Dequeue();
    }

    // Easter eggs: click the yeti or bear while they're showing, or pet the dog. Found secrets persist in localStorage.
    private static readonly Dictionary<string, string> SecretNames = new() { ["yeti"] = "Yeti spotted!", ["bear"] = "Bear spotted!", ["dog"] = "You pet the dog!" };
    private readonly HashSet<string> _secrets = new();
    private string? _secretToast;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Moving between panel layers usually removes the button that was clicked, which drops focus to <body>
        // and the section stops hearing keys (ESC, WASD). Pull focus back whenever the layer changes.
        if (PanelLayer != _focusedLayer)
        {
            _focusedLayer = PanelLayer;
            await _screen.FocusAsync(preventScroll: true);
        }
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "world-secrets");
            _secrets.UnionWith((saved ?? "").Split(',').Where(SecretNames.ContainsKey));
            if (_secrets.Count > 0) StateHasChanged();
        }
        catch (JSException) { } // storage blocked: secrets just won't persist
    }

    private async Task FindSecret(string id)
    {
        if (!_secrets.Add(id)) return;
        var toast = _secretToast = $"{SecretNames[id]} Secrets found: {_secrets.Count}/{SecretNames.Count}";
        StateHasChanged();
        try { await JS.InvokeVoidAsync("localStorage.setItem", "world-secrets", string.Join(",", _secrets)); }
        catch (JSException) { }
        await Task.Delay(3500);
        if (_secretToast == toast) { _secretToast = null; StateHasChanged(); }
    }
    private bool IsNearby(WorldLocation location) => Math.Sqrt(Math.Pow(_playerX - location.X, 2) + Math.Pow(_playerY - location.Y, 2)) < 135;
    private void Interact() { if (NearbyLocation is not null) Inspect(NearbyLocation); }
    private void ReturnHome() { Navigation.NavigateTo("/"); }
    private void Inspect(WorldLocation location)
    {
        ActiveLocation = location;
        HomeRoom = null;
        SelectedWorkStation = null;
        SelectedProject = null;
        ShowProjectLog = false;
        ShowTeamPhotos = false;
        SelectedWorldMemory = MemoriesFor(location.Id).FirstOrDefault();
    }
    private void SelectVehicle(string id) => SelectedVehicle = id;
    private void EnterHomeRoom(string? room) { HomeRoom = room; SelectedVehicle = null; SelectedWorldMemory = room is null ? null : MemoriesFor(room).FirstOrDefault(); }
    private void SelectWorkStation(WorkStation? station) { SelectedWorkStation = station; SelectedProject = null; ShowProjectLog = false; ShowTeamPhotos = false; }
    private void ClearWorkStation() => SelectWorkStation(null);
    private void ToggleProjectLog() { ShowProjectLog = !ShowProjectLog; ShowTeamPhotos = false; SelectedProject = null; }
    private void ToggleTeamPhotos() { ShowTeamPhotos = !ShowTeamPhotos; ShowProjectLog = false; SelectedProject = null; }
    private void SelectProject(WorkProject project) => SelectedProject = project;
    private void SelectWorldMemory(WorldMemory memory) => SelectedWorldMemory = memory;
    private IEnumerable<WorldMemory> MemoriesFor(string locationId) => _worldMemories.Where(memory => memory.LocationId == locationId);

    // Memory board + selected photo, shared by the memory rooms and the inside of the house.
    private RenderFragment MemoryWall(string locationId) => @<div class="life-memory-wall">
        <div class="life-memory-board">
            <div class="life-board-heading"><span>MEMORY WALL</span><small>Select a memory to look closer.</small></div>
            <div class="life-memory-cards">
                @foreach (var memory in MemoriesFor(locationId))
                {
                    <button class="life-memory-card @(SelectedWorldMemory?.ImagePath == memory.ImagePath ? "life-memory-selected" : string.Empty)" @onclick="() => SelectWorldMemory(memory)"><img src="@memory.ImagePath" alt="@memory.Alt" /><strong>@memory.Caption</strong></button>
                }
            </div>
        </div>
        @if (SelectedWorldMemory is not null)
        {
            <figure class="life-memory-display"><img src="@SelectedWorldMemory.ImagePath" alt="@SelectedWorldMemory.Alt" /><figcaption><span>MEMORY</span><strong>@SelectedWorldMemory.Caption</strong><small>@SelectedWorldMemory.Description</small></figcaption></figure>
        }
    </div>;
    private ElementReference _screen;
    private string? _focusedLayer;
    private string PanelLayer => $"{ActiveLocation?.Id}/{HomeRoom}/{SelectedWorkStation?.Id}/{ShowProjectLog}/{ShowTeamPhotos}/{SelectedProject?.Id}";

    // ESC backs out one layer at a time; only the top layer of a location closes the panel.
    private void GoBack()
    {
        if (SelectedProject is not null) SelectedProject = null;
        else if (ShowProjectLog) ShowProjectLog = false;
        else if (ShowTeamPhotos) ShowTeamPhotos = false;
        else if (SelectedWorkStation is not null) ClearWorkStation();
        else if (HomeRoom is not null) EnterHomeRoom(null);
        else ClosePanel();
    }

    private void ClosePanel() { ActiveLocation = null; HomeRoom = null; SelectedVehicle = null; SelectedWorkStation = null; SelectedWorldMemory = null; SelectedProject = null; ShowProjectLog = false; ShowTeamPhotos = false; }
    private void ToggleMinimap() => ShowMinimap = !ShowMinimap;

