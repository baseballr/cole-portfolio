    private void HandleKeyDown(KeyboardEventArgs args)
    {
        var key = args.Key.ToLowerInvariant();
        if (key == "m") { ToggleMinimap(); return; }
        if (key == "escape") { GoBack(); return; }
        if (key == "e") { Interact(); return; }
        if (key == "r") { ReturnHome(); return; }
        if (key == "v") { SwitchVehicle(); return; }
        if (key == "h") { _ = Honk(); return; }
        if (key == "n") { CycleTimeOfDay(); return; }
        if (key is "arrowup" or "w" or "arrowdown" or "s" or "arrowleft" or "a" or "arrowright" or "d")
        {
            _pressedKeys.Add(key);
            MoveFromPressedKeys();
        }
    }

    // Touch screens: touch the truck and pull; it keeps driving toward the finger until released.
    // Touch pointers are implicitly captured, so move/up events keep coming to the truck.
    private async Task StartDrag(PointerEventArgs args)
    {
        if (args.PointerType == "mouse") return; // computers drive with WASD / arrows only
        StopDrag();
        _dragStart = (args.ClientX, args.ClientY);
        _dragX = _dragY = 0;
        var driving = _driving = new CancellationTokenSource();
        while (!driving.IsCancellationRequested)
        {
            var length = Math.Sqrt(_dragX * _dragX + _dragY * _dragY);
            if (length > 12)
            {
                MovePlayer((int)Math.Round(_dragX / length * 20), (int)Math.Round(_dragY / length * 20));
                StateHasChanged();
            }
            await Task.Delay(80);
        }
    }

    private void Drag(PointerEventArgs args)
    {
        if (_dragStart is not { } start) return;
        _dragX = args.ClientX - start.X;
        _dragY = args.ClientY - start.Y;
    }

    private void StopDrag()
    {
        _dragStart = null;
        _driving?.Cancel();
    }

    private void HandleKeyUp(KeyboardEventArgs args) => _pressedKeys.Remove(args.Key.ToLowerInvariant());

    private void MoveFromPressedKeys()
    {
        var x = (_pressedKeys.Contains("arrowright") || _pressedKeys.Contains("d") ? 1 : 0) - (_pressedKeys.Contains("arrowleft") || _pressedKeys.Contains("a") ? 1 : 0);
        var y = (_pressedKeys.Contains("arrowdown") || _pressedKeys.Contains("s") ? 1 : 0) - (_pressedKeys.Contains("arrowup") || _pressedKeys.Contains("w") ? 1 : 0);
        if (x != 0 || y != 0) MovePlayer(x * 20, y * 20);
    }

    private void MovePlayer(int x, int y)
    {
        if (x != 0 || y != 0)
        {
            var angle = Math.Atan2(y, x) * 180 / Math.PI;
            // If angle is between 90 and 180 (left-facing), flip the truck and mirror the angle
            if (angle > 90)
            {
                _truckFacingLeft = true;
                _truckAngle = 180 - angle;
            }
            else if (angle < -90)
            {
                _truckFacingLeft = true;
                _truckAngle = -180 - angle;
            }
            else
            {
                _truckFacingLeft = false;
                _truckAngle = angle;
            }
        }
        var nextX = Math.Clamp(_playerX + x, 40, WorldSize - 40);
        var nextY = Math.Clamp(_playerY + y, 40, WorldSize - 40);
        if (!IsBlocked(nextX, nextY)) { KickUpDust(); _playerX = nextX; _playerY = nextY; }
        ActiveLocation = null;
    }

