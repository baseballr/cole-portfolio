@page "/colesworld"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Cole's World</PageTitle>

<section @ref="_screen" class="world-screen world-@_timeOfDay" tabindex="0" autofocus="autofocus" @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp" @onkeydown:preventDefault="true">
    <div class="world-hud">
        <div class="world-brand"><span class="world-brand-mark">C</span><span>COLE'S WORLD</span>@if (_secrets.Count > 0) { <span class="secret-count" title="Secrets found">★ @_secrets.Count/@SecretNames.Count</span> }</div>
        <button class="vehicle-switch" @onclick="SwitchVehicle" title="Switch vehicle (V)"><span>@Vehicle.Icon</span> @Vehicle.Name <b>⇄</b></button>
    </div>

    <div class="world-viewport" aria-label="Cole's World. Drive with WASD or arrow keys and press E near a location.">
        <div class="world-canvas" style="@CameraStyle">
            <div class="world-sky"></div>
            <div class="world-road world-road-main"></div>
            <div class="world-road road-home"></div>
            <div class="world-road road-work"></div>
            <div class="world-road road-ski"></div>
            <div class="world-road road-church"></div>
            <div class="world-road road-golf"></div>
            <div class="world-road road-fishing"></div>
            <div class="world-road road-camp"></div>
            @foreach (var connection in _roadConnections)
            {
                <span class="world-road-connection @(connection.Y < 700 ? "connection-up" : "connection-down")" style="left:@($"{connection.X}px"); top:@($"{connection.Y}px")"></span>
            }
            <div class="world-bridge" aria-hidden="true"></div>
            <svg class="world-river" viewBox="0 0 1500 1500" aria-hidden="true"><path d="@RiverPath" /><path class="river-flow" d="@RiverPath" /></svg>
            <div class="world-water water-one"><i class="pond-fish"></i><i class="pond-fish pond-fish-two"></i></div>
            <div class="world-mountain mountain-one"></div>
            <div class="world-mountain mountain-two"></div>
            <div class="world-yeti-spot" aria-hidden="true"><span class="world-yeti" @onclick='() => FindSecret("yeti")'></span></div>
            <div class="world-bear-spot" aria-hidden="true"><span class="world-bear" @onclick='() => FindSecret("bear")'></span></div>
            <i class="river-fish" aria-hidden="true"></i>
            <div class="critter critter-dog @(DogExcited ? "critter-dog-excited" : string.Empty)" @onclick="PetDog" style="left:@($"{_dog.X}px"); top:@($"{_dog.Y}px")" aria-hidden="true">
                <svg viewBox="0 0 60 50">
                    <ellipse cx="32" cy="47" rx="22" ry="3" fill="rgba(30, 86, 71, 0.3)" />
                    <path class="dog-tail" d="M44 40 Q54 38 56 28" fill="none" stroke="#d9a456" stroke-width="5" stroke-linecap="round" />
                    <ellipse cx="39" cy="37" rx="12" ry="11" fill="#e3b56c" />
                    <ellipse cx="42" cy="46" rx="7" ry="2.8" fill="#d9a456" />
                    <ellipse cx="27" cy="31" rx="9" ry="13" fill="#e3b56c" />
                    <ellipse cx="24" cy="33" rx="5" ry="8" fill="#f3d59a" />
                    <rect x="27" y="36" width="5" height="11" rx="2.5" fill="#d9a456" />
                    <rect x="20" y="36" width="5" height="11" rx="2.5" fill="#e8bd74" />
                    <path d="M20 25 q7 4 13 0" fill="none" stroke="#d35f46" stroke-width="3" stroke-linecap="round" />
                    <circle cx="26" cy="29" r="1.6" fill="#f5d58f" />
                    <circle cx="25" cy="17" r="9" fill="#e8bd74" />
                    <ellipse class="dog-tongue" cx="17" cy="24" rx="2" ry="2.6" fill="#e56b6f" />
                    <ellipse cx="17.5" cy="20" rx="6.5" ry="4.5" fill="#f3d59a" />
                    <circle cx="12" cy="19" r="2" fill="#2a1d15" />
                    <circle cx="21.5" cy="15" r="1.4" fill="#2a1d15" />
                    <path d="M28 10 q7 1 5 12 q-4 1 -6 -4 z" fill="#c98f45" />
                </svg>
                <span class="dog-heart">♥</span>
                @if (_honking) { <span class="speech">Woof!</span> }
            </div>
            <div class="critter critter-fishers" style="left:@($"{_fishers.X}px"); top:@($"{_fishers.Y}px")" aria-hidden="true">
                <svg viewBox="0 0 120 80">
                    <ellipse cx="34" cy="74" rx="26" ry="3.5" fill="rgba(30, 86, 71, 0.3)" />
                    <rect x="15" y="52" width="5.5" height="21" rx="2" fill="#4a6f96" /><rect x="22" y="52" width="5.5" height="21" rx="2" fill="#4a6f96" />
                    <rect x="13" y="33" width="16" height="22" rx="5" fill="#3a4f55" />
                    <circle cx="21" cy="27" r="6.5" fill="#eab48c" />
                    <ellipse cx="23.5" cy="31" rx="4.5" ry="4" fill="#9a6440" />
                    <rect x="22" y="24" width="5" height="2.2" rx="1" fill="#d35f46" />
                    <rect x="15.5" y="15" width="11" height="7.5" rx="3" fill="#e8d5a8" /><ellipse cx="21" cy="22.5" rx="11" ry="2.3" fill="#d9c28e" />
                    <path d="M24 38 L33 45" stroke="#3a4f55" stroke-width="4.5" stroke-linecap="round" /><circle cx="34" cy="46" r="2.2" fill="#eab48c" />
                    <rect x="41" y="62" width="4" height="11" rx="1.5" fill="#eab48c" /><rect x="46.5" y="62" width="4" height="11" rx="1.5" fill="#eab48c" />
                    <rect x="40" y="58" width="11.5" height="6" rx="2" fill="#4a6f96" />
                    <rect x="40" y="46" width="11.5" height="14" rx="4" fill="#f5c976" />
                    <circle cx="46" cy="41" r="5.2" fill="#eab48c" />
                    <path d="M40.8 40 a5.2 5.2 0 0 1 10.4 0 z" fill="#d35f46" /><rect x="49" y="38.6" width="5" height="1.6" rx="0.8" fill="#b94c38" />
                    <circle cx="48.6" cy="41.5" r="0.8" fill="#2a1d15" />
                    <path d="M47 50 L52 56" stroke="#f5c976" stroke-width="3.5" stroke-linecap="round" /><circle cx="52.5" cy="57" r="1.8" fill="#eab48c" />
                    <g class="angler angler-dad">
                        <ellipse class="splash" cx="86" cy="63" rx="5" ry="1.8" fill="none" stroke="#fff" stroke-width="1.2" />
                        <g class="rod">
                            <line x1="34" y1="46" x2="84" y2="12" stroke="#5a3a24" stroke-width="1.8" stroke-linecap="round" />
                            <line x1="84" y1="12" x2="86" y2="62" stroke="rgba(255, 255, 255, 0.75)" stroke-width="0.7" />
                            <g class="bobber"><circle cx="86" cy="62" r="2.3" fill="#fff" /><path d="M83.7 62 a2.3 2.3 0 0 1 4.6 0 z" fill="#d35f46" /></g>
                            <g class="catch"><ellipse cx="86" cy="67" rx="2.8" ry="5.5" fill="#f59b54" /><path d="M86 71.5 l-3.5 4 h7 z" fill="#e36d3d" /><circle cx="85" cy="64.5" r="0.7" fill="#2a1d15" /></g>
                        </g>
                    </g>
                    <g class="angler angler-boy">
                        <ellipse class="splash" cx="102" cy="69" rx="5" ry="1.8" fill="none" stroke="#fff" stroke-width="1.2" />
                        <g class="rod">
                            <line x1="52" y1="57" x2="100" y2="32" stroke="#5a3a24" stroke-width="1.5" stroke-linecap="round" />
                            <line x1="100" y1="32" x2="102" y2="68" stroke="rgba(255, 255, 255, 0.75)" stroke-width="0.7" />
                            <g class="bobber"><circle cx="102" cy="68" r="2.3" fill="#fff" /><path d="M99.7 68 a2.3 2.3 0 0 1 4.6 0 z" fill="#d35f46" /></g>
                            <g class="catch"><ellipse cx="102" cy="73" rx="2.8" ry="5.5" fill="#f59b54" /><path d="M102 77.5 l-3.5 4 h7 z" fill="#e36d3d" /><circle cx="101" cy="70.5" r="0.7" fill="#2a1d15" /></g>
                        </g>
                    </g>
                </svg>
                @if (_honking) { <span class="speech speech-fishers">Shh! The fish!</span> }
            </div>

            @foreach (var item in _scenery)
            {
                <span class="scenery scenery-@item.Kind" style="left:@($"{item.X}px"); top:@($"{item.Y}px")"></span>
            }

            @foreach (var location in _locations)
            {
                <button class="world-location @(IsNearby(location) ? "location-nearby" : string.Empty) @(ActiveLocation?.Id == location.Id ? "location-active" : string.Empty)" style="left:@($"{location.X}px"); top:@($"{location.Y}px")" @onclick="() => Inspect(location)" aria-label="Inspect @location.Name">
                    <span class="location-building location-building-@location.Id">@location.Icon</span>
                    <span class="location-name">@location.Name</span>
                </button>
            }

            <div class="world-shade"></div>
            @foreach (var (x, y) in _fireflies)
            {
                <i class="firefly" style="left:@($"{x}px"); top:@($"{y}px")"></i>
            }
            @foreach (var puff in _dust)
            {
                <i @key="puff.Id" class="dust-puff" style="left:@($"{puff.X}px"); top:@($"{puff.Y}px")"></i>
            }
            @if (_honking)
            {
                <span class="speech speech-honk" style="left:@($"{_playerX}px"); top:@($"{_playerY}px")">HONK!</span>
            }

            <div class="world-truck world-truck-@Vehicle.Id" style="@TruckStyle" aria-label="Your @Vehicle.Name" @onpointerdown="StartDrag" @onpointermove="Drag" @onpointerup="StopDrag" @onpointercancel="StopDrag">
                <span class="truck-body"><span class="truck-bed"></span><span class="truck-cab"></span><span class="truck-hood"></span></span><i class="truck-wheel wheel-front"></i><i class="truck-wheel wheel-back"></i>
            </div>
        </div>
    </div>

    @if (ActiveLocation is not null)
    {
        <aside class="world-panel" @onclick:stopPropagation="true">
            @if (ActiveLocation.Id == "work")
            {
                <div class="office-interior-screen">
                    <div class="office-topbar"><button @onclick="ClosePanel">← Back outside</button><span>SOFTWARE ENGINEERING / @(SelectedWorkStation is null ? "OFFICE FLOOR" : "CUBICLE")</span><strong>WORK // BUILDING 01</strong></div>
                    @if (SelectedWorkStation is null)
                    {
                        <div class="office-room">
                            <div class="office-sign"><span>COLE'S</span><strong>WORK</strong><small>SELECT A DOOR TO ENTER</small></div>
                            <div class="office-floor"></div>
                            <div class="office-doors">
                                @foreach (var station in _workStations)
                                {
                                    <button class="office-door" @onclick="() => SelectWorkStation(station)">
                                        <span class="door-number">0@(Array.IndexOf(_workStations, station) + 1)</span>
                                        <span class="door-screen">@station.Icon</span>
                                        <strong>@station.ShortName</strong>
                                        <small>@station.Company</small>
                                        <em>ENTER →</em>
                                    </button>
                                }
                            </div>
                            <p class="office-floor-note">A small office floor for the systems, people, and problems that shaped the work.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cubicle-inside">
                            <button class="inside-back" @onclick="ClearWorkStation">← OFFICE FLOOR</button>
                            <div class="cubicle-window"><span>NOW ENTERING</span><strong>@SelectedWorkStation.Company</strong><small>@SelectedWorkStation.Title</small></div>
                            <div class="inside-desk"><button class="inside-monitor" @onclick="ToggleProjectLog" aria-pressed="@ShowProjectLog"><span>@SelectedWorkStation.Icon</span><small>PROJECT LOG</small></button><div class="inside-keyboard"></div>@if (MemoriesFor(SelectedWorkStation.Id).FirstOrDefault() is { } framed) { <button class="inside-photo-frame" @onclick="ToggleTeamPhotos" aria-pressed="@ShowTeamPhotos"><img src="@framed.ImagePath" alt="" /><small>TEAM PHOTOS</small></button> }</div>
                            @if (ShowProjectLog)
                            {
                                <div class="project-log-desk">
                                    <div class="project-log-heading"><span>PROJECT LOG</span><strong>@SelectedWorkStation.Company</strong><small>Select a sheet to inspect the work.</small></div>
                                    <div class="project-papers">
                                        @foreach (var project in SelectedWorkStation.Projects)
                                        {
                                            <button class="project-paper @(SelectedProject?.Id == project.Id ? "paper-selected" : string.Empty)" @onclick="() => SelectProject(project)">
                                                <span class="paper-pin"></span><strong>@project.Title</strong><small>@project.Summary</small><em>@project.Technologies</em>
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (SelectedProject is not null)
                                {
                                    <article class="project-monitor-detail"><div class="monitor-detail-bar"><span></span><span></span><span></span><small>PROJECT LOG // @SelectedWorkStation.ShortName</small></div><div class="monitor-detail-screen"><span class="panel-category">PROJECT DETAIL</span><h2>@SelectedProject.Title</h2><p>@SelectedProject.Detail</p><span class="paper-tech">@SelectedProject.Technologies</span></div></article>
                                }
                            }
                            else if (ShowTeamPhotos)
                            {
                                <div class="garage-pegboard cubicle-pegboard">
                                    @foreach (var memory in MemoriesFor(SelectedWorkStation.Id))
                                    {
                                        <figure class="pinned-photo"><span class="paper-pin"></span><img src="@memory.ImagePath" alt="@memory.Alt" /><figcaption><strong>@memory.Caption</strong><small>@memory.Description</small></figcaption></figure>
                                    }
                                </div>
                            }
                            else
                            {
                                <article class="inside-data"><span class="panel-category">@SelectedWorkStation.Company</span><h1>@SelectedWorkStation.Title</h1><p>@SelectedWorkStation.Description</p><div class="inside-tech"><span>TECHNOLOGIES</span><div>@foreach (var technology in SelectedWorkStation.Technologies) { <b>@technology</b> }</div></div><p class="monitor-hint">Click the monitor to open the project log.</p></article>
                            }
                        </div>
                    }
                </div>
            }
            else if (ActiveLocation.Id is "fishing" or "camp" or "church" or "golf" or "ski")
            {
                <div class="life-interior-screen">
                    <div class="life-topbar"><button @onclick="ClosePanel">← Back outside</button><span>@ActiveLocation.Name / MEMORY ROOM</span><strong>COLE'S WORLD</strong></div>
                    <div class="life-scene life-scene-@ActiveLocation.Id">
                        <div class="life-scene-title"><span>@ActiveLocation.Category</span><h1>@ActiveLocation.Name</h1><small>@ActiveLocation.Subtitle</small></div>
                        <div class="life-set-piece life-set-piece-@ActiveLocation.Id" aria-hidden="true"></div>
                        @MemoryWall(ActiveLocation.Id)
                    </div>
                </div>
            }
            else
            {
                <div class="home-interior-screen">
                    <div class="office-topbar">@if (HomeRoom is null) { <button @onclick="ClosePanel">← Back outside</button> } else { <button @onclick="() => EnterHomeRoom(null)">← Front yard</button> }<span>HOME / @(HomeRoom switch { "garage" => "GARAGE", "house" => "INSIDE", _ => "FRONT YARD" })</span><strong>HOME BASE</strong></div>
                    @if (HomeRoom is null)
                    {
                        <div class="home-front">
                            <div class="home-front-title"><span>@ActiveLocation.Category</span><h1>@ActiveLocation.Name</h1><small>@ActiveLocation.Subtitle</small></div>
                            <div class="house-facade">
                                <div class="house-roof"></div>
                                <div class="house-wall">
                                    <span class="house-window" aria-hidden="true"></span>
                                    <button class="house-door" @onclick='() => EnterHomeRoom("house")'><span>FRONT DOOR</span></button>
                                    <button class="house-garage" @onclick='() => EnterHomeRoom("garage")'><span>GARAGE</span></button>
                                </div>
                            </div>
                            <p class="home-front-note">Bought my first home in 2025. Outside of software development, I spend a lot of time working on projects around the house, from electrical work and landscaping to building things in the yard.</p>
                        </div>
                    }
                    else
                    {
                        @if (HomeRoom == "house")
                        {
                            <div class="life-scene life-scene-house">
                                <div class="life-scene-title"><span>INSIDE THE HOUSE</span><h1>Home</h1><small>A few of the moments that made it home.</small></div>
                                @MemoryWall("house")
                            </div>
                        }
                        else
                        {
                            <div class="home-room home-room-garage">
                                <div class="garage-vehicles">
                                    @foreach (var vehicle in _garageVehicles)
                                    {
                                        <button class="garage-vehicle @(SelectedVehicle == vehicle.Id ? "garage-vehicle-selected" : string.Empty)" @onclick="() => SelectVehicle(vehicle.Id)"><span>@vehicle.Icon</span><strong>@vehicle.Name</strong></button>
                                    }
                                </div>
                                @if (SelectedVehicle is null)
                                {
                                    <p class="garage-hint">Pick a ride to see the pictures pinned to the pegboard.</p>
                                }
                                else
                                {
                                    <div class="garage-pegboard">
                                        @foreach (var memory in MemoriesFor(SelectedVehicle))
                                        {
                                            <figure class="pinned-photo"><span class="paper-pin"></span><img src="@memory.ImagePath" alt="@memory.Alt" /><figcaption><strong>@memory.Caption</strong><small>@memory.Description</small></figcaption></figure>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </aside>
    }

    @if (ShowMinimap)
    {
        <div class="world-minimap" @onclick:stopPropagation="true">
            <div class="minimap-title">MAP <button @onclick="ToggleMinimap" aria-label="Close map">×</button></div>
            <svg class="minimap-map" viewBox="0 0 1500 1500" role="img" aria-label="Map of Cole's World">
                <rect width="1500" height="1500" fill="#79b99d" />
                <polygon points="890,290 1130,-20 1370,290" fill="#6f9a8c" /><polygon points="1072,54 1130,-20 1188,54" fill="#f2ead0" />
                <polygon points="1120,330 1310,120 1500,330" fill="#587f73" /><polygon points="1264,170 1310,120 1356,170" fill="#f2ead0" />
                <path d="@RiverPath" fill="none" stroke="#5facc0" stroke-width="44" stroke-linecap="round" />
                <ellipse cx="1350" cy="1165" rx="220" ry="155" transform="rotate(-12 1350 1165)" fill="#5facc0" stroke="#e9dcb5" stroke-width="16" />
                @foreach (var tree in _scenery.Where(item => item.Kind is "oak" or "pine"))
                {
                    <circle cx="@tree.X" cy="@(tree.Y - 20)" r="18" fill="@(tree.Kind == "pine" ? "#225d4b" : "#2f806a")" />
                }
                @foreach (var road in _mapRoads)
                {
                    <rect x="@road.X" y="@road.Y" width="@road.W" height="@road.H" fill="#e9dcb5" stroke="#e9dcb5" stroke-width="28" />
                }
                @foreach (var road in _mapRoads)
                {
                    <rect x="@road.X" y="@road.Y" width="@road.W" height="@road.H" fill="#56635f" />
                }
                <line x1="0" y1="706" x2="1500" y2="706" stroke="#fff0bc" stroke-width="8" stroke-dasharray="50 40" />
                <rect x="1378" y="650" width="64" height="112" fill="#a87450" />
                @foreach (var location in _locations)
                {
                    <g class="mm-place mm-place-@location.Id @(IsNearby(location) ? "mm-place-near" : string.Empty)">
                        <circle cx="@location.X" cy="@location.Y" r="48" />
                        <text x="@location.X" y="@(location.Y - 72)">@(location.Id switch { "work" => "Work", "fishing" => "Dock", _ => location.Name })</text>
                        <title>@location.Name</title>
                    </g>
                }
                <circle class="mm-player-ring" cx="@_playerX" cy="@_playerY" r="44" />
                <circle class="mm-player" cx="@_playerX" cy="@_playerY" r="34" />
            </svg>
            <p>@(NearbyLocation is { } near ? $"Near {near.Name}" : "Drive to discover places")</p>
        </div>
    }

    @if (NearbyLocation is not null && ActiveLocation is null)
    {
        <button class="interact-prompt" @onclick="Interact"><span class="prompt-keys"><span>↵</span> PRESS <strong>E</strong> TO ENTER</span><span class="prompt-touch">TAP TO ENTER</span> @NearbyLocation.Name</button>
    }

    @if (_secretToast is not null)
    {
        <div class="secret-toast" role="status">@_secretToast</div>
    }

    <div class="world-controls"><span data-short="WASD  DRIVE" data-touch="DRAG TO DRIVE"><b>WASD</b> / <b>ARROWS</b> Drive</span><button @onclick="Interact" data-short="E  ENTER" data-touch="ENTER"><b>E</b> Interact</button><button @onclick="ToggleMinimap" data-short="M  MAP" data-touch="MAP"><b>M</b> Map</button><button @onclick="Honk" data-short="H  HONK" data-touch="HONK"><b>H</b> Honk</button><button @onclick="ClosePanel" data-short="ESC  CLOSE" data-touch="CLOSE"><b>ESC</b> Close</button><button @onclick="ReturnHome" data-short="R  HOME" data-touch="HOME"><b>R</b> Return to home page</button></div>
</section>

@code {
    private const int WorldSize = 1500;
    private int _playerX = 300;
    private int _playerY = 650;
    private bool ShowMinimap;
    private WorldLocation? ActiveLocation { get; set; }
    private string? HomeRoom { get; set; }
    private string? SelectedVehicle { get; set; }
    private WorkStation? SelectedWorkStation { get; set; }
    private WorldMemory? SelectedWorldMemory { get; set; }
    private WorkProject? SelectedProject { get; set; }
    private bool ShowProjectLog { get; set; }
    private bool ShowTeamPhotos { get; set; }
    private double _truckAngle;
    private bool _truckFacingLeft;
    private readonly HashSet<string> _pressedKeys = new();
    private CancellationTokenSource? _driving;
    private (double X, double Y)? _dragStart;
    private double _dragX, _dragY;

    private readonly WorkStation[] _workStations =
    {
        new("Deloitte", "Deloitte", "Florida Department of Children and Families", "Caseworker platform", "Worked on modernizing a web application used by the department, including a data comparison tool that helps caseworkers process cases.", "▣", new[] { "C#", ".NET", "Blazor", "SQL", "Azure" }, new[]
    {
            new WorkProject("wizards", "FLDCF Wizards", "Caseworker comparison tool", "Built a data comparison tool that aggregates government sources to help caseworkers process Medicaid, SNAP, and TANF applications.", "C# · .NET · Azure · React"),
            new WorkProject("datamart", "Datamart", "103M+ row data pipeline", "Built a daily batch job that aggregates data and writes complete SFTP output in under eight minutes for teams validating a system migration.", "C# · .NET · Batch · MSSQL · Oracle"),
            new WorkProject("portal", "FLDCF Worker Portal", "Modernization foundation", "Led a five-developer team delivering UI features and integrations for a multi-year modernization program.", "C# · .NET · React · Azure · MSSQL")
    }),
        new("brown", "B&B", "Brown & Brown", "Insurance systems", "Built applications supporting insurance brokers, secure file sharing, compliance automation, and modernized legacy systems.", "▣", new[] { "C#", ".NET", "React", "SQL", "Azure" }, new[]
    {
            new WorkProject("eando", "Monthly E&O Survey", "Monthly compliance automation", "Conceptualized and developed a monthly compliance survey sent to more than 6,000 teammates to keep the company aligned with legal standards.", "Azure Logic Apps · C# · .NET · Power BI · Survey Monkey"),
            new WorkProject("qualys", "Qualys Report", "Security visibility pipeline", "Built a daily pipeline that ingests Qualys vulnerability data into MSSQL and surfaces it in Power BI so security leaders can prioritize fixes.", "Power BI · Azure Data Factory · MSSQL"),
            new WorkProject("jua", "JUA", "Secure file sharing", "Modernized a secure file-sharing site where users upload and download large files with granular security down to the file and folder level.", "Entra ID · C# · .NET · Blazor · Azure Blobs · MSSQL")
    }),
    };

