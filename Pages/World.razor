                                <animateMotion dur="6s" repeatCount="indefinite" calcMode="linear" keyPoints="0;0;1;1" keyTimes="0;0.55;0.8;1" path="M40 44 C70 58 84 22 124 14" />
                                <animate attributeName="opacity" values="1;1;0;0" keyTimes="0;0.8;0.82;1" dur="6s" repeatCount="indefinite" /></g>
