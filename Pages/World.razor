    // Time of day follows the visitor's clock (WebAssembly uses the browser's time zone); N cycles it.
    private static readonly string[] TimesOfDay = { "day", "dusk", "night" };
    private string _timeOfDay = DateTime.Now.Hour switch { >= 8 and < 18 => "day", (>= 6 and < 8) or (>= 18 and < 20) => "dusk", _ => "night" };
    private void CycleTimeOfDay() => _timeOfDay = TimesOfDay[(Array.IndexOf(TimesOfDay, _timeOfDay) + 1) % TimesOfDay.Length];
