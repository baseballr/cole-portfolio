@page "/colesworld"
@inject NavigationManager Navigation

<PageTitle>Cole's World</PageTitle>

<section class="world-screen" tabindex="0" autofocus="autofocus" @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp" @onkeydown:preventDefault="true">
    <div class="world-hud">
        <div class="world-brand"><span class="world-brand-mark">C</span><span>COLE'S WORLD</span></div>
        <button class="vehicle-switch" @onclick="SwitchVehicle" title="Switch vehicle (V)"><span>@Vehicle.Icon</span> @Vehicle.Name <b>⇄</b></button>
    </div>

    <div class="world-viewport" aria-label="Cole's World. Drive with WASD or arrow keys and press E near a location.">
        <div class="world-canvas" style="@CameraStyle">
            <div class="world-sky"></div>
            <div class="world-road world-road-main"></div>
            <div class="world-road road-home"></div>
            <div class="world-road road-work"></div>
            <div class="world-road road-ski"></div>
            <div class="world-road road-church"></div>
            <div class="world-road road-golf"></div>
            <div class="world-road road-fishing"></div>
            <div class="world-road road-camp"></div>
            @foreach (var connection in _roadConnections)
            {
                <span class="world-road-connection" style="left:@($"{connection.X}px"); top:@($"{connection.Y}px")"></span>
            }
            <svg class="world-river" viewBox="0 0 1500 1500" aria-hidden="true"><path d="M1330 320 C1340 420 1440 470 1425 560 S1395 800 1435 900 S1415 1000 1395 1070" /></svg>
            <div class="world-water water-one"></div>
            <div class="world-mountain mountain-one"></div>
            <div class="world-mountain mountain-two"></div>

            @foreach (var item in _scenery)
            {
                <span class="scenery scenery-@item.Kind" style="left:@($"{item.X}px"); top:@($"{item.Y}px")"></span>
            }

            @foreach (var location in _locations)
            {
                <button class="world-location @(IsNearby(location) ? "location-nearby" : string.Empty) @(ActiveLocation?.Id == location.Id ? "location-active" : string.Empty)" style="left:@($"{location.X}px"); top:@($"{location.Y}px")" @onclick="() => Inspect(location)" aria-label="Inspect @location.Name">
                    <span class="location-building location-building-@location.Id">@location.Icon</span>
                    <span class="location-name">@location.Name</span>
                </button>
            }

            <div class="world-truck world-truck-@Vehicle.Id" style="@TruckStyle" aria-label="Your @Vehicle.Name" @onpointerdown="StartDrag" @onpointermove="Drag" @onpointerup="StopDrag" @onpointercancel="StopDrag">
                <span class="truck-body"><span class="truck-bed"></span><span class="truck-cab"></span><span class="truck-hood"></span></span><i class="truck-wheel wheel-front"></i><i class="truck-wheel wheel-back"></i>
            </div>
        </div>
    </div>

    @if (ActiveLocation is not null)
    {
        <aside class="world-panel" @onclick:stopPropagation="true">
            @if (ActiveLocation.Id == "work")
            {
                <div class="office-interior-screen">
                    <div class="office-topbar"><button @onclick="ClosePanel">← Back outside</button><span>SOFTWARE ENGINEERING / @(SelectedWorkStation is null ? "OFFICE FLOOR" : "CUBICLE")</span><strong>WORK // BUILDING 01</strong></div>
                    @if (SelectedWorkStation is null)
                    {
                        <div class="office-room">
                            <div class="office-sign"><span>COLE'S</span><strong>WORK</strong><small>SELECT A DOOR TO ENTER</small></div>
                            <div class="office-floor"></div>
                            <div class="office-doors">
                                @foreach (var station in _workStations)
                                {
                                    <button class="office-door" @onclick="() => SelectWorkStation(station)">
                                        <span class="door-number">0@(Array.IndexOf(_workStations, station) + 1)</span>
                                        <span class="door-screen">@station.Icon</span>
                                        <strong>@station.ShortName</strong>
                                        <small>@station.Company</small>
                                        <em>ENTER →</em>
                                    </button>
                                }
                            </div>
                            <p class="office-floor-note">A small office floor for the systems, people, and problems that shaped the work.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cubicle-inside">
                            <button class="inside-back" @onclick="ClearWorkStation">← OFFICE FLOOR</button>
                            <div class="cubicle-window"><span>NOW ENTERING</span><strong>@SelectedWorkStation.Company</strong><small>@SelectedWorkStation.Title</small></div>
                            <div class="inside-desk"><button class="inside-monitor" @onclick="ToggleProjectLog" aria-pressed="@ShowProjectLog"><span>@SelectedWorkStation.Icon</span><small>PROJECT LOG</small></button><div class="inside-keyboard"></div></div>
                            @if (ShowProjectLog)
                            {
                                <div class="project-log-desk">
                                    <div class="project-log-heading"><span>PROJECT LOG</span><strong>@SelectedWorkStation.Company</strong><small>Select a sheet to inspect the work.</small></div>
                                    <div class="project-papers">
                                        @foreach (var project in SelectedWorkStation.Projects)
                                        {
                                            <button class="project-paper @(SelectedProject?.Id == project.Id ? "paper-selected" : string.Empty)" @onclick="() => SelectProject(project)">
                                                <span class="paper-pin"></span><strong>@project.Title</strong><small>@project.Summary</small><em>@project.Technologies</em>
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (SelectedProject is not null)
                                {
                                    <article class="project-monitor-detail"><div class="monitor-detail-bar"><span></span><span></span><span></span><small>PROJECT LOG // @SelectedWorkStation.ShortName</small></div><div class="monitor-detail-screen"><span class="panel-category">PROJECT DETAIL</span><h2>@SelectedProject.Title</h2><p>@SelectedProject.Detail</p><span class="paper-tech">@SelectedProject.Technologies</span></div></article>
                                }
                            }
                            else
                            {
                                <article class="inside-data"><span class="panel-category">@SelectedWorkStation.Company</span><h1>@SelectedWorkStation.Title</h1><p>@SelectedWorkStation.Description</p><div class="inside-tech"><span>TECHNOLOGIES</span><div>@foreach (var technology in SelectedWorkStation.Technologies) { <b>@technology</b> }</div></div><p class="monitor-hint">Click the monitor to open the project log.</p></article>
                            }
                        </div>
                    }
                </div>
            }
            else if (ActiveLocation.Id is "fishing" or "camp" or "church" or "golf" or "ski")
            {
                <div class="life-interior-screen">
                    <div class="life-topbar"><button @onclick="ClosePanel">← Back outside</button><span>@ActiveLocation.Name / MEMORY ROOM</span><strong>COLE'S WORLD</strong></div>
                    <div class="life-scene life-scene-@ActiveLocation.Id">
                        <div class="life-scene-title"><span>@ActiveLocation.Category</span><h1>@ActiveLocation.Name</h1><small>@ActiveLocation.Subtitle</small></div>
                        <div class="life-set-piece life-set-piece-@ActiveLocation.Id" aria-hidden="true"></div>
                        @MemoryWall(ActiveLocation.Id)
                    </div>
                </div>
            }
            else
            {
                <div class="home-interior-screen">
                    <div class="office-topbar">@if (HomeRoom is null) { <button @onclick="ClosePanel">← Back outside</button> } else { <button @onclick="() => EnterHomeRoom(null)">← Front yard</button> }<span>HOME / @(HomeRoom switch { "garage" => "GARAGE", "house" => "INSIDE", _ => "FRONT YARD" })</span><strong>HOME BASE</strong></div>
                    @if (HomeRoom is null)
                    {
                        <div class="home-front">
                            <div class="home-front-title"><span>@ActiveLocation.Category</span><h1>@ActiveLocation.Name</h1><small>@ActiveLocation.Subtitle</small></div>
                            <div class="house-facade">
                                <div class="house-roof"></div>
                                <div class="house-wall">
                                    <span class="house-window" aria-hidden="true"></span>
                                    <button class="house-door" @onclick='() => EnterHomeRoom("house")'><span>FRONT DOOR</span></button>
                                    <button class="house-garage" @onclick='() => EnterHomeRoom("garage")'><span>GARAGE</span></button>
                                </div>
                            </div>
                            <p class="home-front-note">Bought my first home in 2025. Outside of software development, I spend a lot of time working on projects around the house, from electrical work and landscaping to building things in the yard.</p>
                        </div>
                    }
                    else
                    {
                        @if (HomeRoom == "house")
                        {
                            <div class="life-scene life-scene-house">
                                <div class="life-scene-title"><span>INSIDE THE HOUSE</span><h1>Home</h1><small>A few of the moments that made it home.</small></div>
                                @MemoryWall("house")
                            </div>
                        }
                        else
                        {
                            <div class="home-room home-room-garage">
                                <div class="garage-vehicles">
                                    @foreach (var vehicle in _garageVehicles)
                                    {
                                        <button class="garage-vehicle @(SelectedVehicle == vehicle.Id ? "garage-vehicle-selected" : string.Empty)" @onclick="() => SelectVehicle(vehicle.Id)"><span>@vehicle.Icon</span><strong>@vehicle.Name</strong></button>
                                    }
                                </div>
                                @if (SelectedVehicle is null)
                                {
                                    <p class="garage-hint">Pick a ride to see the pictures pinned to the pegboard.</p>
                                }
                                else
                                {
                                    <div class="garage-pegboard">
                                        @foreach (var memory in MemoriesFor(SelectedVehicle))
                                        {
                                            <figure class="pinned-photo"><span class="paper-pin"></span><img src="@memory.ImagePath" alt="@memory.Alt" /><figcaption><strong>@memory.Caption</strong><small>@memory.Description</small></figcaption></figure>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </aside>
    }

    @if (ShowMinimap)
    {
        <div class="world-minimap" @onclick:stopPropagation="true">
            <div class="minimap-title">MINIMAP <button @onclick="ToggleMinimap" aria-label="Close minimap">×</button></div>
            <div class="minimap-world">
                <span class="minimap-road minimap-road-main"></span>
                <span class="minimap-road minimap-road-home"></span>
                <span class="minimap-road minimap-road-work"></span>
                <span class="minimap-road minimap-road-ski"></span>
                <span class="minimap-road minimap-road-church"></span>
                <span class="minimap-road minimap-road-golf"></span>
                <span class="minimap-road minimap-road-camp"></span>
                <span class="minimap-road minimap-road-fishing"></span>
                @foreach (var location in _locations)
                {
                    <span class="minimap-location" style="left:@($"{location.X / 15}px"); top:@($"{location.Y / 15}px")">@location.Icon</span>
                }
                <span class="minimap-player" style="left:@($"{_playerX / 15}px"); top:@($"{_playerY / 15}px")"></span>
            </div>
            <p>Drive to discover places</p>
        </div>
    }

    @if (NearbyLocation is not null && ActiveLocation is null)
    {
        <button class="interact-prompt" @onclick="Interact"><span class="prompt-keys"><span>↵</span> PRESS <strong>E</strong> TO ENTER</span><span class="prompt-touch">TAP TO ENTER</span> @NearbyLocation.Name</button>
    }


    <div class="world-controls"><span data-short="WASD  DRIVE" data-touch="DRAG TO DRIVE"><b>WASD</b> / <b>ARROWS</b> Drive</span><button @onclick="Interact" data-short="E  ENTER" data-touch="ENTER"><b>E</b> Interact</button><button @onclick="ToggleMinimap" data-short="M  MAP" data-touch="MAP"><b>M</b> Map</button><button @onclick="ClosePanel" data-short="ESC  CLOSE" data-touch="CLOSE"><b>ESC</b> Close</button><button @onclick="ReturnHome" data-short="R  HOME" data-touch="HOME"><b>R</b> Return to home page</button></div>
</section>

@code {
    private const int WorldSize = 1500;
    private int _playerX = 300;
    private int _playerY = 650;
    private bool ShowMinimap;
    private WorldLocation? ActiveLocation { get; set; }
    private string? HomeRoom { get; set; }
    private string? SelectedVehicle { get; set; }
    private WorkStation? SelectedWorkStation { get; set; }
    private WorldMemory? SelectedWorldMemory { get; set; }
    private WorkProject? SelectedProject { get; set; }
    private bool ShowProjectLog { get; set; }
    private double _truckAngle;
    private bool _truckFacingLeft;
    private readonly HashSet<string> _pressedKeys = new();
    private CancellationTokenSource? _driving;
    private (double X, double Y)? _dragStart;
    private double _dragX, _dragY;

    private readonly WorkStation[] _workStations =
    {
        new("Deloitte", "Deloitte", "Florida Department of Children and Families", "Caseworker platform", "Worked on modernizing a web application used by the department, including a data comparison tool that helps caseworkers process cases.", "▣", new[] { "C#", ".NET", "Blazor", "SQL", "Azure" }, new[]
    {
            new WorkProject("wizards", "FLDCF Wizards", "Caseworker comparison tool", "Built a data comparison tool that aggregates government sources to help caseworkers process Medicaid, SNAP, and TANF applications.", "C# · .NET · Azure · React"),
            new WorkProject("datamart", "Datamart", "103M+ row data pipeline", "Built a daily batch job that aggregates data and writes complete SFTP output in under eight minutes for teams validating a system migration.", "C# · .NET · Batch · MSSQL · Oracle"),
            new WorkProject("portal", "FLDCF Worker Portal", "Modernization foundation", "Led a five-developer team delivering UI features and integrations for a multi-year modernization program.", "C# · .NET · React · Azure · MSSQL")
    }),
        new("brown", "B&B", "Brown & Brown", "Insurance systems", "Built applications supporting insurance brokers, secure file sharing, compliance automation, and modernized legacy systems.", "▣", new[] { "C#", ".NET", "React", "SQL", "Azure" }, new[]
    {
            new WorkProject("eando", "Monthly E&O Survey", "Monthly compliance automation", "Conceptualized and developed a monthly compliance survey sent to more than 6,000 teammates to keep the company aligned with legal standards.", "Azure Logic Apps · C# · .NET · Power BI · Survey Monkey"),
            new WorkProject("qualys", "Qualys Report", "Security visibility pipeline", "Built a daily pipeline that ingests Qualys vulnerability data into MSSQL and surfaces it in Power BI so security leaders can prioritize fixes.", "Power BI · Azure Data Factory · MSSQL"),
            new WorkProject("jua", "JUA", "Secure file sharing", "Modernized a secure file-sharing site where users upload and download large files with granular security down to the file and folder level.", "Entra ID · C# · .NET · Blazor · Azure Blobs · MSSQL")
    }),
    };

    private readonly WorldMemory[] _worldMemories =
    {
        new("fishing", "images/world/DogBeach.jpg", "Cole outdoors", "Dog Beach", "A quiet day outside, with time to slow down and enjoy being away from a screen."),
        new("camp", "images/world/IMG_1357.jpg", "Cole on an outdoor adventure", "Camp life", "Hammock camping, open air, and a little distance from the usual routine."),
        new("church", "images/world/GraysonConfirmation.jpg", "", "Community and service", "The confirmation into the church of one of my students!"),
        new("church", "images/world/DirtBikeGrayson.jpg", "Cole with confirman", "Celebration", "Celebrating confirmation with my confirmee Grayson."),
        new("golf", "images/world/NolesGame.jpg", "Cole at FSU", "Sports and competition", "A few favorite teams, and enjoying time with family."),
        new("golf", "images/world/DirtbikeHump.jpg", "Cole Racing", "Sports and competition", "Aiming for first and tons of laughs."),
        new("house", "images/world/FirstHome.jpg", "Cole in front of his first home", "My first home", "Bought my first home in 2025."),
        new("house", "images/world/Proposal.jpg", "Cole proposing to his fiancée", "The proposal", "The day I asked my fiancée to marry me."),
        new("bronco", "images/world/Bronco.jpg", "Cole driving his Bronco on an off-road trail", "2022 Ford Bronco", "Used for exploring, camping, hauling stuff, and generally getting into trouble."),
        new("f150", "images/world/F150.jpg", "Cole's Ford F-150", "Ford F-150", ""),
        new("dirtbike", "images/world/DirtbikeMud.JPG", "Cole racing his dirt bike through the mud", "2018 Honda CRF450R", "One of my hobbies outside of software development."),
        new("dirtbike", "images/world/DirtbikeHump.jpg", "Cole racing his dirt bike", "Race day", "Aiming for first and tons of laughs."),
        new("ski", "images/world/Skiing.jpg", "Cole on an adventure", "Skiing new terrain", "Intermediate skier, mostly East Coast, always looking for the next mountain."),
    };

    // Decorative map scenery, anchored at its base (X, Y). Kinds: oak, pine, bush, flowers, rock, reeds.
    private readonly (int X, int Y, string Kind)[] _scenery =
    {
        (560, 100, "pine"), (640, 170, "pine"), (700, 120, "pine"), (960, 250, "pine"), (1010, 300, "pine"), (1200, 340, "pine"),
        (1260, 380, "pine"), (1475, 330, "pine"), (1480, 420, "pine"),
        (95, 180, "oak"), (180, 240, "oak"), (120, 520, "oak"), (470, 200, "oak"), (560, 450, "oak"), (990, 480, "oak"),
        (95, 910, "oak"), (210, 1180, "oak"), (360, 930, "oak"), (820, 1010, "oak"), (900, 1250, "oak"), (640, 1260, "oak"),
        (1340, 880, "oak"), (520, 1400, "oak"), (80, 1400, "oak"),
        (200, 560, "bush"), (420, 540, "bush"), (700, 560, "bush"), (950, 580, "bush"), (1200, 560, "bush"), (160, 820, "bush"),
        (520, 880, "bush"), (760, 880, "bush"), (980, 860, "bush"), (300, 1330, "bush"), (780, 1400, "bush"), (1000, 1420, "bush"),
        (140, 380, "flowers"), (420, 420, "flowers"), (600, 330, "flowers"), (1330, 620, "flowers"), (500, 1000, "flowers"),
        (860, 1150, "flowers"), (330, 1250, "flowers"), (700, 1350, "flowers"),
        (1010, 430, "rock"), (1180, 250, "rock"), (560, 1100, "rock"), (980, 1150, "rock"),
        (1375, 600, "reeds"), (1460, 860, "reeds"), (1125, 1120, "reeds"), (1140, 1250, "reeds")
    };

    // Patches over the main road's edge where a side road joins (roads are 86px wide including borders).
    // Y covers the main road's 7px border and edge line: top edge at 650, bottom edge at 762 - 20px patch.
    private readonly (int X, int Y)[] _roadConnections =
    {
        (300, 650), (820, 650), (1110, 650), (650, 742), (430, 742), (1280, 742),
        (1110, 742)
    };

    private readonly (string Id, string Name, string Icon)[] _garageVehicles =
    {
        ("bronco", "2022 Ford Bronco", "🚙"), ("f150", "Ford F-150", "🛻"), ("dirtbike", "2018 Honda CRF450R", "🏍")
    };

    private readonly List<WorldLocation> _locations = new()
    {
        new("home", "Home", "HOME BASE", "⌂", "Where the projects start", 300, 390),
        new("work", "Software Engineering", "WORK", "▣", "Building systems that solve real problems", 820, 300),
        new("ski", "Ski Lodge", "HOBBY AREA", "⛷", "A little farther up the mountain", 1110, 165),
        new("camp", "Camping", "OUTDOORS", "⛺", "Away from the screen", 1110, 940),
        new("fishing", "Fishing Dock", "OUTDOORS", "♧", "A quiet place to cast a line", 1280, 1130),
        new("golf", "Sports", "INTERESTS", "⛳", "A few favorite teams and a moving target", 430, 1110),
        new("church", "Church", "COMMUNITY", "✚", "A place to serve and gather", 650, 850)
    };

    private string CameraStyle => $"--player-x:{_playerX}px; --player-y:{_playerY}px";
    // Drivable vehicles are the garage vehicles; starts in the F-150.
    private int _vehicleIndex = 1;
    private (string Id, string Name, string Icon) Vehicle => _garageVehicles[_vehicleIndex];
    private void SwitchVehicle() => _vehicleIndex = (_vehicleIndex + 1) % _garageVehicles.Length;
    private string TruckStyle => $"left:{_playerX}px; top:{_playerY}px; --truck-angle:{_truckAngle}deg; --truck-scale:{(_truckFacingLeft ? -1 : 1)}";
    private WorldLocation? NearbyLocation => _locations.FirstOrDefault(IsNearby);

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        var key = args.Key.ToLowerInvariant();
        if (key == "m") { ToggleMinimap(); return; }
        if (key == "escape") { ClosePanel(); return; }
        if (key == "e") { Interact(); return; }
        if (key == "r") { ReturnHome(); return; }
        if (key == "v") { SwitchVehicle(); return; }
        if (key is "arrowup" or "w" or "arrowdown" or "s" or "arrowleft" or "a" or "arrowright" or "d")
        {
            _pressedKeys.Add(key);
            MoveFromPressedKeys();
        }
    }

    // Touch screens: touch the truck and pull; it keeps driving toward the finger until released.
    // Touch pointers are implicitly captured, so move/up events keep coming to the truck.
    private async Task StartDrag(PointerEventArgs args)
    {
        if (args.PointerType == "mouse") return; // computers drive with WASD / arrows only
        StopDrag();
        _dragStart = (args.ClientX, args.ClientY);
        _dragX = _dragY = 0;
        var driving = _driving = new CancellationTokenSource();
        while (!driving.IsCancellationRequested)
        {
            var length = Math.Sqrt(_dragX * _dragX + _dragY * _dragY);
            if (length > 12)
            {
                MovePlayer((int)Math.Round(_dragX / length * 20), (int)Math.Round(_dragY / length * 20));
                StateHasChanged();
            }
            await Task.Delay(80);
        }
    }

    private void Drag(PointerEventArgs args)
    {
        if (_dragStart is not { } start) return;
        _dragX = args.ClientX - start.X;
        _dragY = args.ClientY - start.Y;
    }

    private void StopDrag()
    {
        _dragStart = null;
        _driving?.Cancel();
    }

    private void HandleKeyUp(KeyboardEventArgs args) => _pressedKeys.Remove(args.Key.ToLowerInvariant());

    private void MoveFromPressedKeys()
    {
        var x = (_pressedKeys.Contains("arrowright") || _pressedKeys.Contains("d") ? 1 : 0) - (_pressedKeys.Contains("arrowleft") || _pressedKeys.Contains("a") ? 1 : 0);
        var y = (_pressedKeys.Contains("arrowdown") || _pressedKeys.Contains("s") ? 1 : 0) - (_pressedKeys.Contains("arrowup") || _pressedKeys.Contains("w") ? 1 : 0);
        if (x != 0 || y != 0) MovePlayer(x * 20, y * 20);
    }

    private void MovePlayer(int x, int y)
    {
        if (x != 0 || y != 0)
        {
            var angle = Math.Atan2(y, x) * 180 / Math.PI;
            // If angle is between 90 and 180 (left-facing), flip the truck and mirror the angle
            if (angle > 90)
            {
                _truckFacingLeft = true;
                _truckAngle = 180 - angle;
            }
            else if (angle < -90)
            {
                _truckFacingLeft = true;
                _truckAngle = -180 - angle;
            }
            else
            {
                _truckFacingLeft = false;
                _truckAngle = angle;
            }
        }
        var nextX = Math.Clamp(_playerX + x, 40, WorldSize - 40);
        var nextY = Math.Clamp(_playerY + y, 40, WorldSize - 40);
        if (!HitsBuilding(nextX, nextY)) { _playerX = nextX; _playerY = nextY; }
        ActiveLocation = null;
    }

    private bool HitsBuilding(int x, int y) => _locations.Any(location => x > location.X - 90 && x < location.X + 90 && y > location.Y - 70 && y < location.Y + 70);
    private bool IsNearby(WorldLocation location) => Math.Sqrt(Math.Pow(_playerX - location.X, 2) + Math.Pow(_playerY - location.Y, 2)) < 135;
    private void Interact() { if (NearbyLocation is not null) Inspect(NearbyLocation); }
    private void ReturnHome() { Navigation.NavigateTo("/"); }
    private void Inspect(WorldLocation location)
    {
        ActiveLocation = location;
        HomeRoom = null;
        SelectedWorkStation = null;
        SelectedProject = null;
        ShowProjectLog = false;
        SelectedWorldMemory = MemoriesFor(location.Id).FirstOrDefault();
    }
    private void SelectVehicle(string id) => SelectedVehicle = id;
    private void EnterHomeRoom(string? room) { HomeRoom = room; SelectedVehicle = null; SelectedWorldMemory = room is null ? null : MemoriesFor(room).FirstOrDefault(); }
    private void SelectWorkStation(WorkStation? station) { SelectedWorkStation = station; SelectedProject = null; ShowProjectLog = false; }
    private void ClearWorkStation() => SelectWorkStation(null);
    private void ToggleProjectLog() { ShowProjectLog = !ShowProjectLog; SelectedProject = null; }
    private void SelectProject(WorkProject project) => SelectedProject = project;
    private void SelectWorldMemory(WorldMemory memory) => SelectedWorldMemory = memory;
    private IEnumerable<WorldMemory> MemoriesFor(string locationId) => _worldMemories.Where(memory => memory.LocationId == locationId);

    // Memory board + selected photo, shared by the memory rooms and the inside of the house.
    private RenderFragment MemoryWall(string locationId) => @<div class="life-memory-wall">
        <div class="life-memory-board">
            <div class="life-board-heading"><span>MEMORY WALL</span><small>Select a memory to look closer.</small></div>
            <div class="life-memory-cards">
                @foreach (var memory in MemoriesFor(locationId))
                {
                    <button class="life-memory-card @(SelectedWorldMemory?.ImagePath == memory.ImagePath ? "life-memory-selected" : string.Empty)" @onclick="() => SelectWorldMemory(memory)"><img src="@memory.ImagePath" alt="@memory.Alt" /><strong>@memory.Caption</strong></button>
                }
            </div>
        </div>
        @if (SelectedWorldMemory is not null)
        {
            <figure class="life-memory-display"><img src="@SelectedWorldMemory.ImagePath" alt="@SelectedWorldMemory.Alt" /><figcaption><span>MEMORY</span><strong>@SelectedWorldMemory.Caption</strong><small>@SelectedWorldMemory.Description</small></figcaption></figure>
        }
    </div>;
    private void ClosePanel() { ActiveLocation = null; HomeRoom = null; SelectedVehicle = null; SelectedWorkStation = null; SelectedWorldMemory = null; SelectedProject = null; ShowProjectLog = false; }
    private void ToggleMinimap() => ShowMinimap = !ShowMinimap;

    private sealed record WorldLocation(string Id, string Name, string Category, string Icon, string Subtitle, int X, int Y);
    private sealed record WorkStation(string Id, string ShortName, string Company, string Title, string Description, string Icon, IReadOnlyList<string> Technologies, IReadOnlyList<WorkProject> Projects);
    private sealed record WorkProject(string Id, string Title, string Summary, string Detail, string Technologies);
    private sealed record WorldMemory(string LocationId, string ImagePath, string Alt, string Caption, string Description);
}