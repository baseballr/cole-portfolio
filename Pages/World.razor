            new WorkProject("jua", "JUA", "Secure file sharing", "Modernized a secure file-sharing site where users upload and download large files with granular security down to the file and folder level.", "Entra ID · C# · .NET · Blazor · Azure Blobs · MSSQL")
        }),
    };

    private readonly FishingMemory[] _fishingMemories =
    {
        new("images/carousel/IMG_0273.jpg", "Cole outdoors", "OUTDOORS / A DAY OUTSIDE"),
        new("images/carousel/IMG_3337.jpg", "Cole exploring outside", "EXPLORING / NEW PLACES"),
        new("images/carousel/IMG_3386.jpg", "Cole on an outdoor adventure", "ADVENTURE / KEEP MOVING"),
        new("images/carousel/IMG_3403.jpg", "Cole enjoying time away from a screen", "QUIET TIME / OUTDOORS")
    };

    private readonly (int X, int Y)[] _trees =
    {
        (95, 180), (180, 230), (1380, 180), (1310, 260), (95, 910), (220, 1160),
        (1360, 880), (1280, 1260), (720, 115), (640, 1230), (1040, 1320), (360, 930)
    };

    private readonly List<WorldLocation> _locations = new()
    {
        new("home", "Home", "HOME BASE", "⌂", "Where the projects start", "Bought my first home in 2025. Outside of software development, I spend a lot of time working on projects around the house, from electrical work and landscaping to building things in the yard.", Array.Empty<string>(), new[]
        {
            new WorldObject("Workshop", "⚒", "The place where house projects become weekend projects."),
            new WorldObject("Yard", "▱", "Landscaping, building, and a healthy amount of figuring it out as I go."),
            new WorldObject("2018 Honda CRF450R", "🏍", "One of my hobbies outside of software development."),
            new WorldObject("2022 Ford Bronco", "🚙", "Used for exploring, camping, hauling stuff, and generally getting into trouble."),
            new WorldObject("Tools", "⚒", "The right tool makes a hard project a lot more interesting."),
            new WorldObject("Computer", "▣", "Where the other kind of building happens.")
        }, 300, 390),
        new("work", "Software Engineering", "WORK", "▣", "Building systems that solve real problems", "A career built across government technology and insurance systems, leading teams, modernizing legacy applications, and carrying difficult work through to production.", new[] { "C#", ".NET", "React", "Blazor", "SQL", "Azure" }, new[]
        {
            new WorldObject("Florida DCF", "▣", "Worked on modernizing a web application used by the department. C# · .NET · Blazor · SQL · Azure"),
            new WorldObject("Brown & Brown", "▣", "Built applications supporting insurance brokers and modernized legacy systems. C# · .NET · React · SQL · Azure"),
            new WorldObject("Azure", "☁", "Cloud services, data pipelines, API Management, Functions, and the infrastructure between an idea and production.")
        }, 820, 300),
        new("ski", "Ski Lodge", "HOBBY AREA", "⛷", "A little farther up the mountain", "Intermediate skier. Mostly East Coast. I enjoy exploring new mountains and pushing myself onto harder terrain.", Array.Empty<string>(), new[]
        {
            new WorldObject("Skis", "⛷", "Leaning against the lodge and waiting for the next run.")
        }, 1110, 165),
        new("camp", "Camping", "OUTDOORS", "⛺", "Away from the screen", "I enjoy getting outdoors and spending time away from a screen. Hammock camping is one of my favorites.", Array.Empty<string>(), new[]
        {
            new WorldObject("Campfire", "🔥", "A good fire, a quiet night, and nowhere else to be."),
