    private void MoveFromPressedKeys()
    {
        var x = (_pressedKeys.Contains("arrowright") || _pressedKeys.Contains("d") ? 1 : 0) - (_pressedKeys.Contains("arrowleft") || _pressedKeys.Contains("a") ? 1 : 0);
        var y = (_pressedKeys.Contains("arrowdown") || _pressedKeys.Contains("s") ? 1 : 0) - (_pressedKeys.Contains("arrowup") || _pressedKeys.Contains("w") ? 1 : 0);
        if (x != 0 || y != 0) MovePlayer(x * 20, y * 20);
    }

    private void MovePlayer(int x, int y)
    {
        if (x != 0 || y != 0)
        {
            var angle = Math.Atan2(y, x) * 180 / Math.PI;
            // If angle is between 90 and 180 (left-facing), flip the truck and mirror the angle
            if (angle > 90)
            {
                _truckFacingLeft = true;
                _truckAngle = 180 - angle;
            }
            else if (angle < -90)
            {
                _truckFacingLeft = true;
                _truckAngle = -180 - angle;
            }
            else
            {
                _truckFacingLeft = false;
                _truckAngle = angle;
            }
        }
        var nextX = Math.Clamp(_playerX + x, 40, WorldSize - 40);
        var nextY = Math.Clamp(_playerY + y, 40, WorldSize - 40);
        if (!IsBlocked(nextX, nextY)) { KickUpDust(); _playerX = nextX; _playerY = nextY; }
        ActiveLocation = null;
    }

