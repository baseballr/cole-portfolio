@page "/colesworld"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Cole's World</PageTitle>

<section @ref="_screen" class="world-screen world-@_timeOfDay season-@_season weather-@_weather" tabindex="0" autofocus="autofocus" @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp" @onkeydown:preventDefault="true">
    <div class="world-hud">
        <div class="world-brand"><span class="world-brand-mark">C</span><span>COLE'S WORLD</span>@if (_secrets.Count > 0) { <span class="secret-count" title="Secrets found">★ @_secrets.Count/@SecretNames.Count</span> }</div>
        <button class="vehicle-switch" @onclick="SwitchVehicle" title="Switch vehicle (V)"><span>@Vehicle.Icon</span> @Vehicle.Name <b>⇄</b></button>
    </div>

    <div class="world-viewport" aria-label="Cole's World. Drive with WASD or arrow keys and press E near a location.">
        <div class="world-canvas" style="@CameraStyle">
            <div class="world-sky"></div>
            <div class="world-road world-road-main"></div>
            <div class="world-road road-home"></div>
            <div class="world-road road-work"></div>
            <div class="world-road road-ski"></div>
            <div class="world-road road-church"></div>
            <div class="world-road road-golf"></div>
            <div class="world-road road-fishing"></div>
            <div class="world-road road-camp"></div>
            @foreach (var connection in _roadConnections)
            {
                <span class="world-road-connection @(connection.Y < 700 ? "connection-up" : "connection-down")" style="left:@($"{connection.X}px"); top:@($"{connection.Y}px")"></span>
            }
            <div class="world-bridge" aria-hidden="true"></div>
            <svg class="world-river" viewBox="0 0 1500 1500" aria-hidden="true"><path d="@RiverPath" /><path class="river-flow" d="@RiverPath" /></svg>
            <div class="world-water water-one"><i class="pond-fish"></i><i class="pond-fish pond-fish-two"></i></div>
            <div class="world-mountain mountain-one"></div>
            <div class="world-mountain mountain-two"></div>
            <div class="world-yeti-spot" aria-hidden="true"><span class="world-yeti" @onclick='() => FindSecret("yeti")'></span></div>
            <div class="world-bear-spot" aria-hidden="true"><span class="world-bear" @onclick='() => FindSecret("bear")'></span></div>
            <i class="river-fish" aria-hidden="true"></i>
            <div class="critter critter-dog @(DogExcited ? "critter-dog-excited" : string.Empty)" @onclick="PetDog" style="left:@($"{_dog.X}px"); top:@($"{_dog.Y}px")" aria-hidden="true">
                <svg viewBox="0 0 60 50">
                    <ellipse cx="32" cy="47" rx="22" ry="3" fill="rgba(30, 86, 71, 0.3)" />
                    <path class="dog-tail" d="M44 40 Q54 38 56 28" fill="none" stroke="#d9a456" stroke-width="5" stroke-linecap="round" />
                    <ellipse cx="39" cy="37" rx="12" ry="11" fill="#e3b56c" />
                    <ellipse cx="42" cy="46" rx="7" ry="2.8" fill="#d9a456" />
                    <ellipse cx="27" cy="31" rx="9" ry="13" fill="#e3b56c" />
                    <ellipse cx="24" cy="33" rx="5" ry="8" fill="#f3d59a" />
                    <rect x="27" y="36" width="5" height="11" rx="2.5" fill="#d9a456" />
                    <rect x="20" y="36" width="5" height="11" rx="2.5" fill="#e8bd74" />
                    <path d="M20 25 q7 4 13 0" fill="none" stroke="#d35f46" stroke-width="3" stroke-linecap="round" />
                    <circle cx="26" cy="29" r="1.6" fill="#f5d58f" />
                    <circle cx="25" cy="17" r="9" fill="#e8bd74" />
                    <ellipse class="dog-tongue" cx="17" cy="24" rx="2" ry="2.6" fill="#e56b6f" />
                    <ellipse cx="17.5" cy="20" rx="6.5" ry="4.5" fill="#f3d59a" />
                    <circle cx="12" cy="19" r="2" fill="#2a1d15" />
                    <circle cx="21.5" cy="15" r="1.4" fill="#2a1d15" />
                    <path d="M28 10 q7 1 5 12 q-4 1 -6 -4 z" fill="#c98f45" />
                </svg>
                <span class="dog-heart">♥</span>
                @if (_honking) { <span class="speech">Woof!</span> }
            </div>
            <div class="critter critter-fishers" style="left:@($"{_fishers.X}px"); top:@($"{_fishers.Y}px")" aria-hidden="true">
                <svg viewBox="0 0 120 80">
                    @if (FamilyActivity == "skating")
                    {
                        <path d="M70 72 q20 -5 45 1 M76 76 q18 -3 36 0" stroke="rgba(255, 255, 255, 0.8)" stroke-width="0.8" fill="none" />
                        <g class="skaters">
                            <ellipse cx="95" cy="74" rx="20" ry="2.5" fill="rgba(30, 86, 71, 0.25)" />
                            <path d="M82 53 L79 72 M88 53 L92 72" stroke="#4a6f96" stroke-width="5" stroke-linecap="round" />
                            <path d="M75 73.5 h8 M88 73.5 h8" stroke="#cfd8dc" stroke-width="1.4" stroke-linecap="round" />
                            <rect x="77" y="33" width="16" height="22" rx="5" fill="#3a4f55" />
                            <path d="M80 38 L72 45" stroke="#3a4f55" stroke-width="4.5" stroke-linecap="round" /><circle cx="71" cy="46" r="2.2" fill="#eab48c" />
                            <path d="M90 38 L99 47" stroke="#3a4f55" stroke-width="4.5" stroke-linecap="round" />
                            <circle cx="85" cy="27" r="6.5" fill="#eab48c" /><ellipse cx="87.5" cy="31" rx="4.5" ry="4" fill="#9a6440" />
                            <path d="M78.5 26 a6.5 6.5 0 0 1 13 0 z" fill="#5aa0c8" /><circle cx="85" cy="19.5" r="2" fill="#fff" />
                            <rect x="78" y="33" width="14" height="3.5" rx="1.5" fill="#d35f46" /><rect x="88" y="34" width="3" height="9" fill="#d35f46" />
                            <path d="M102 62 L101 72 M106 62 L109 72" stroke="#4a6f96" stroke-width="4" stroke-linecap="round" />
                            <path d="M98 73.5 h6 M106 73.5 h6" stroke="#cfd8dc" stroke-width="1.2" stroke-linecap="round" />
                            <rect x="98" y="46" width="11.5" height="16" rx="4" fill="#f5c976" />
                            <path d="M100 50 L99.5 47" stroke="#f5c976" stroke-width="3.5" stroke-linecap="round" /><circle cx="99.5" cy="47" r="1.8" fill="#eab48c" />
                            <path d="M108 50 L114 55" stroke="#f5c976" stroke-width="3.5" stroke-linecap="round" /><circle cx="114.5" cy="55.5" r="1.8" fill="#eab48c" />
                            <circle cx="104" cy="41" r="5.2" fill="#eab48c" /><path d="M98.8 40 a5.2 5.2 0 0 1 10.4 0 z" fill="#d35f46" /><circle cx="104" cy="34.5" r="1.6" fill="#fff" />
                            <circle cx="106.6" cy="41.5" r="0.8" fill="#2a1d15" />
                        </g>
                    }
                    else
                    {
                    <ellipse cx="34" cy="74" rx="26" ry="3.5" fill="rgba(30, 86, 71, 0.3)" />
                    <rect x="15" y="52" width="5.5" height="21" rx="2" fill="#4a6f96" /><rect x="22" y="52" width="5.5" height="21" rx="2" fill="#4a6f96" />
                    <rect x="13" y="33" width="16" height="22" rx="5" fill="#3a4f55" />
                    <circle cx="21" cy="27" r="6.5" fill="#eab48c" />
                    <ellipse cx="23.5" cy="31" rx="4.5" ry="4" fill="#9a6440" />
                    <rect x="22" y="24" width="5" height="2.2" rx="1" fill="#d35f46" />
                    <rect x="15.5" y="15" width="11" height="7.5" rx="3" fill="#e8d5a8" /><ellipse cx="21" cy="22.5" rx="11" ry="2.3" fill="#d9c28e" />
                    <path d="M24 38 L33 45" stroke="#3a4f55" stroke-width="4.5" stroke-linecap="round" /><circle cx="34" cy="46" r="2.2" fill="#eab48c" />
                    <rect x="41" y="62" width="4" height="11" rx="1.5" fill="#eab48c" /><rect x="46.5" y="62" width="4" height="11" rx="1.5" fill="#eab48c" />
                    <rect x="40" y="58" width="11.5" height="6" rx="2" fill="#4a6f96" />
                    <rect x="40" y="46" width="11.5" height="14" rx="4" fill="#f5c976" />
                    <circle cx="46" cy="41" r="5.2" fill="#eab48c" />
                    <path d="M40.8 40 a5.2 5.2 0 0 1 10.4 0 z" fill="#d35f46" /><rect x="49" y="38.6" width="5" height="1.6" rx="0.8" fill="#b94c38" />
                    <circle cx="48.6" cy="41.5" r="0.8" fill="#2a1d15" />
                    <path d="M47 50 L52 56" stroke="#f5c976" stroke-width="3.5" stroke-linecap="round" /><circle cx="52.5" cy="57" r="1.8" fill="#eab48c" />
                    }
                    @switch (FamilyActivity)
                    {
                        case "eggs":
                            <path d="M49 59 q4.5 -8 9 0" stroke="#9a6440" stroke-width="1.2" fill="none" />
                            <ellipse cx="51" cy="58.5" rx="1.6" ry="2" fill="#f7a8c4" /><ellipse cx="55" cy="58.5" rx="1.6" ry="2" fill="#5aa0c8" />
                            <path d="M48 59 h11 l-1.5 7 h-8 z" fill="#c98f45" /><path d="M48.5 62 h10" stroke="#9a6440" stroke-width="0.8" />
                            <g class="hunt-egg"><ellipse cx="-6" cy="70" rx="2.6" ry="3.4" fill="#f5c976" /><path d="M-8.5 70 h5" stroke="#fff" stroke-width="0.9" /></g>
                            <g class="hunt-egg hunt-egg-two"><ellipse cx="5" cy="76" rx="2.6" ry="3.4" fill="#b99be0" /><path d="M2.5 76 h5" stroke="#fff" stroke-width="0.9" /></g>
                            <path d="M-12 73 q3 -7 6 0 q3 -6 5 0" fill="#5d9a4a" />
                            break;
                        case "dinner":
                            <ellipse cx="36" cy="45.5" rx="5.5" ry="2" fill="#e3b56c" /><ellipse cx="36" cy="44.8" rx="4" ry="1.2" fill="#c65b43" />
                            <ellipse cx="54.5" cy="56.5" rx="4" ry="1.2" fill="#fff" stroke="#cfd8dc" stroke-width="0.5" />
                            @* Table sits up the bank (shifted left) so it stays clear of the pond's edge. *@
                            <g transform="translate(-28 0)">
                            <g class="dinner-steam" stroke="rgba(255, 255, 255, 0.8)" stroke-width="1" fill="none"><path d="M26 48 q-2 -3 0 -6 t0 -6" /><path d="M31 47 q-2 -3 0 -6 t0 -6" /></g>
                            <rect x="4" y="63" width="2.5" height="11" fill="#7c6545" /><rect x="57" y="63" width="2.5" height="11" fill="#7c6545" />
                            <path d="M-2 58 h66 v8 h-66 z" fill="#fff8e6" /><path d="M-2 58 h66 v2 h-66 z" fill="#f0e2bd" /><rect x="22" y="58" width="18" height="8" fill="#e88a3a" />
                            <ellipse cx="10" cy="57.5" rx="4" ry="1.2" fill="#fff" stroke="#cfd8dc" stroke-width="0.5" />
                            <ellipse cx="28.5" cy="55" rx="7" ry="4.5" fill="#b8733f" /><ellipse cx="27" cy="53.5" rx="3.5" ry="1.8" fill="#d99a5c" />
                            <path d="M22 56 l-3 -3 M35 56 l3 -3" stroke="#b8733f" stroke-width="2.2" stroke-linecap="round" /><circle cx="18.6" cy="52.6" r="1.1" fill="#fff" /><circle cx="38.4" cy="52.6" r="1.1" fill="#fff" />
                            <ellipse cx="46" cy="57" rx="4" ry="2.5" fill="#e88a3a" /><rect x="45.5" y="53.5" width="1.2" height="2" fill="#5d7a3a" />
                            </g>
                            break;
                        case "pumpkin":
                            <line x1="34" y1="46" x2="37" y2="54" stroke="#b3bbb2" stroke-width="1.2" stroke-linecap="round" />
                            <ellipse cx="42" cy="68" rx="12" ry="8" fill="#e88a3a" /><ellipse cx="42" cy="68" rx="6" ry="8" fill="#f59b54" /><ellipse cx="42" cy="68" rx="2" ry="8" fill="#e88a3a" />
                            <rect x="40.5" y="57.5" width="3" height="4" rx="1" fill="#5d7a3a" />
                            <g class="pumpkin-face carve-glow"><polygon points="35,66 39,66 37,63" /><polygon points="45,66 49,66 47,63" /><path d="M35 70 Q42 76 49 70 L46.5 71.5 L45 70.5 L42 72 L39 70.5 L37.5 71.5 Z" /></g>
                            <path d="M58 74 q2 -3 4 0 q2 -3 4 0" fill="#e88a3a" />
                            break;
                        case "fishing":
                    <g class="angler angler-dad">
                        <ellipse class="splash" cx="86" cy="63" rx="5" ry="1.8" fill="none" stroke="#fff" stroke-width="1.2" />
                        <g class="rod">
                            <line x1="34" y1="46" x2="84" y2="12" stroke="#5a3a24" stroke-width="1.8" stroke-linecap="round" />
                            <line x1="84" y1="12" x2="86" y2="62" stroke="rgba(255, 255, 255, 0.75)" stroke-width="0.7" />
                            <g class="bobber"><circle cx="86" cy="62" r="2.3" fill="#fff" /><path d="M83.7 62 a2.3 2.3 0 0 1 4.6 0 z" fill="#d35f46" /></g>
                            <g class="catch"><ellipse cx="86" cy="67" rx="2.8" ry="5.5" fill="#f59b54" /><path d="M86 71.5 l-3.5 4 h7 z" fill="#e36d3d" /><circle cx="85" cy="64.5" r="0.7" fill="#2a1d15" /></g>
                        </g>
                    </g>
                    <g class="angler angler-boy">
                        <ellipse class="splash" cx="102" cy="69" rx="5" ry="1.8" fill="none" stroke="#fff" stroke-width="1.2" />
                        <g class="rod">
                            <line x1="52" y1="57" x2="100" y2="32" stroke="#5a3a24" stroke-width="1.5" stroke-linecap="round" />
                            <line x1="100" y1="32" x2="102" y2="68" stroke="rgba(255, 255, 255, 0.75)" stroke-width="0.7" />
                            <g class="bobber"><circle cx="102" cy="68" r="2.3" fill="#fff" /><path d="M99.7 68 a2.3 2.3 0 0 1 4.6 0 z" fill="#d35f46" /></g>
                            <g class="catch"><ellipse cx="102" cy="73" rx="2.8" ry="5.5" fill="#f59b54" /><path d="M102 77.5 l-3.5 4 h7 z" fill="#e36d3d" /><circle cx="101" cy="70.5" r="0.7" fill="#2a1d15" /></g>
                        </g>
                    </g>
                            break;
                    }
                </svg>
                @if (_honking)
                {
                    <span class="speech speech-fishers">@(FamilyActivity switch { "skating" => "Whoa! Don't crack the ice!", "eggs" => "Shh! You'll scare the bunny!", "dinner" => "Dinner's almost ready!", "pumpkin" => "Boo!", _ => "Shh! The fish!" })</span>
                }
            </div>
            <div class="cloud-shadow cloud-1"></div><div class="cloud-shadow cloud-2"></div><div class="cloud-shadow cloud-3"></div>

            <div class="mailbox @(NearMailbox ? "mailbox-near" : string.Empty)" style="left:@($"{_mailbox.X}px"); top:@($"{_mailbox.Y}px")" @onclick="OpenMailbox" title="Contact Cole">
                <span class="mailbox-sign">CONTACT</span>
                <svg viewBox="0 0 34 44">
                    <ellipse cx="17" cy="42.5" rx="12" ry="2" fill="rgba(30, 86, 71, 0.3)" />
                    <rect x="14.5" y="20" width="5" height="23" fill="#7c6545" />
                    <path d="M3 22 V13 a9 9 0 0 1 9 -9 h10 a9 9 0 0 1 9 9 v9 z" fill="#c65b43" />
                    <path d="M3 22 V13 a9 9 0 0 1 9 -9 v18 z" fill="#a8483a" />
                    <rect x="0" y="11" width="11" height="7" fill="#fff8e6" transform="rotate(-18 5 14)" />
                    <g class="mailbox-flag"><rect x="29" y="2" width="2.5" height="14" fill="#f6d18a" /><rect x="29" y="2" width="9" height="5" fill="#e56b6f" /></g>
                </svg>
            </div>

            <div class="decor decor-flags" style="left:212px; top:490px" aria-hidden="true">
                <svg viewBox="0 0 90 80" width="90" height="80">
                    <defs>
                        <clipPath id="flag-wave"><path d="M40 0 C30 -2 20 3 10 1 C6 0 3 1 0 2 L0 26 C3 25 6 24 10 25 C20 27 30 22 40 24 Z"><animate attributeName="d" values="M40 0 C30 -2 20 3 10 1 C6 0 3 1 0 2 L0 26 C3 25 6 24 10 25 C20 27 30 22 40 24 Z;M40 0 C30 3 20 -2 10 2 C6 3 3 2 0 1 L0 25 C3 26 6 27 10 26 C20 22 30 27 40 24 Z;M40 0 C30 -2 20 3 10 1 C6 0 3 1 0 2 L0 26 C3 25 6 24 10 25 C20 27 30 22 40 24 Z" dur="1.6s" repeatCount="indefinite" /></path></clipPath>
                        <linearGradient id="flag-shade" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="20" y2="0" spreadMethod="repeat">
                            <stop offset="0" stop-color="#000" stop-opacity="0" /><stop offset="0.5" stop-color="#000" stop-opacity="0.2" /><stop offset="1" stop-color="#000" stop-opacity="0" />
                            <animateTransform attributeName="gradientTransform" type="translate" from="0 0" to="-20 0" dur="1.6s" repeatCount="indefinite" />
                        </linearGradient>
                    </defs>
                    <ellipse cx="62" cy="78" rx="26" ry="2.5" fill="rgba(30, 86, 71, 0.3)" />
                    <!-- Florida: white field, red saltire, state seal. Shorter pole, flies below the US flag. -->
                    <rect x="39" y="12" width="2.2" height="66" fill="#c9c3b3" /><circle cx="40.1" cy="11" r="2.2" fill="#f6d18a" />
                    <g transform="translate(0 16)" clip-path="url(#flag-wave)">
                        <rect x="-2" y="-3" width="44" height="31" fill="#fff" />
                        <path d="M0 0 L40 24 M40 0 L0 24" stroke="#c8102e" stroke-width="4.5" />
                        <circle cx="20" cy="12" r="4.2" fill="#f5d58f" stroke="#fff" stroke-width="0.8" /><circle cx="20" cy="12" r="2" fill="#5aa0c8" />
                        <rect x="-2" y="-3" width="44" height="31" fill="url(#flag-shade)" />
                    </g>
                    <!-- United States: canton at the hoist (pole side). Taller pole. -->
                    <rect x="84" y="2" width="2.4" height="76" fill="#c9c3b3" /><circle cx="85.2" cy="2" r="2.4" fill="#f6d18a" />
                    <g transform="translate(44 6)" clip-path="url(#flag-wave)">
                        <rect x="-2" y="-3" width="44" height="31" fill="#b22234" />
                        <path d="M-2 2.77 H42 M-2 6.46 H42 M-2 10.15 H42 M-2 13.85 H42 M-2 17.54 H42 M-2 21.23 H42" stroke="#fff" stroke-width="1.85" />
                        <rect x="23" y="-3" width="19" height="16" fill="#3c3b6e" />
                        <g fill="#fff"><circle cx="26" cy="1.5" r="0.7" /><circle cx="30" cy="1.5" r="0.7" /><circle cx="34" cy="1.5" r="0.7" /><circle cx="38" cy="1.5" r="0.7" /><circle cx="28" cy="4.5" r="0.7" /><circle cx="32" cy="4.5" r="0.7" /><circle cx="36" cy="4.5" r="0.7" /><circle cx="26" cy="7.5" r="0.7" /><circle cx="30" cy="7.5" r="0.7" /><circle cx="34" cy="7.5" r="0.7" /><circle cx="38" cy="7.5" r="0.7" /><circle cx="28" cy="10.5" r="0.7" /><circle cx="32" cy="10.5" r="0.7" /><circle cx="36" cy="10.5" r="0.7" /></g>
                        <rect x="-2" y="-3" width="44" height="31" fill="url(#flag-shade)" />
                    </g>
                </svg>
            </div>

            @switch (_season)
            {
                case "christmas":
                    <div class="decor decor-lit" style="left:160px; top:335px">
                        <svg viewBox="0 -2 50 72" width="50" height="72">
                            <rect x="22" y="56" width="6" height="12" fill="#7c6545" />
                            <polygon points="25,6 42,28 8,28" fill="#2e7a62" /><polygon points="25,6 42,28 25,28" fill="#225d4b" />
                            <polygon points="25,16 45,42 5,42" fill="#2e7a62" /><polygon points="25,16 45,42 25,42" fill="#225d4b" />
                            <polygon points="25,28 48,58 2,58" fill="#2e7a62" /><polygon points="25,28 48,58 25,58" fill="#225d4b" />
                            <g class="xmas-bulbs"><circle cx="18" cy="24" r="2.4" fill="#e56b6f" /><circle cx="31" cy="21" r="2.4" fill="#5aa0c8" /><circle cx="14" cy="38" r="2.4" fill="#f6d18a" /><circle cx="34" cy="36" r="2.4" fill="#e56b6f" /><circle cx="22" cy="50" r="2.4" fill="#5aa0c8" /><circle cx="38" cy="52" r="2.4" fill="#f6d18a" /><circle cx="10" cy="53" r="2.4" fill="#e56b6f" /></g>
                            <polygon points="25,0 27.4,5 33,5.4 28.6,8.8 30.2,14 25,11 19.8,14 21.4,8.8 17,5.4 22.6,5" fill="#f6d18a" />
                            <rect x="30" y="61" width="9" height="8" fill="#d35f46" /><rect x="33.5" y="61" width="2" height="8" fill="#f6d18a" /><rect x="11" y="62" width="8" height="7" fill="#5aa0c8" /><rect x="14" y="62" width="2" height="7" fill="#fff0bc" />
                        </svg>
                    </div>
                    <div class="decor" style="left:600px; top:610px">
                        <svg viewBox="0 0 36 50" width="36" height="50">
                            <ellipse cx="18" cy="48" rx="14" ry="2.5" fill="rgba(30, 86, 71, 0.3)" />
                            <line x1="11" y1="22" x2="2" y2="16" stroke="#7c6545" stroke-width="1.5" /><line x1="25" y1="22" x2="34" y2="17" stroke="#7c6545" stroke-width="1.5" />
                            <circle cx="18" cy="38" r="10" fill="#f4f7f8" /><circle cx="18" cy="23" r="7.5" fill="#f4f7f8" /><circle cx="18" cy="11" r="6" fill="#f4f7f8" />
                            <circle cx="18" cy="22" r="0.9" fill="#1f2d33" /><circle cx="18" cy="27" r="0.9" fill="#1f2d33" />
                            <rect x="11" y="16" width="14" height="3" rx="1.5" fill="#d35f46" /><rect x="20" y="17" width="3" height="8" fill="#d35f46" />
                            <circle cx="16" cy="10" r="0.9" fill="#1f2d33" /><circle cx="20" cy="10" r="0.9" fill="#1f2d33" /><polygon points="18,12 25,13 18,14" fill="#f59b54" />
                            <rect x="12" y="1" width="12" height="5" fill="#1f2d33" /><rect x="10" y="5.5" width="16" height="1.8" fill="#1f2d33" />
                        </svg>
                    </div>
                    break;
                case "halloween":
