@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <header class="site-header @( _menuOpen ? "menu-open" : string.Empty)">
        <div class="header-inner">
            <button class="menu-toggle" @onclick="ToggleMenu" aria-expanded="@_menuOpen" aria-label="Toggle navigation">&#9776;</button>
            <a href="/" class="brand">Cole Spitzer<span class="accent">.</span></a>
            <nav class="site-nav @(_menuOpen ? "open" : string.Empty)">
                <a href="/about" @onclick="CloseMenu">About</a>
                <a href="/experience" @onclick="CloseMenu">Experience</a>
                <a href="/projects" @onclick="CloseMenu">Projects</a>
                <a href="/employmenthistory" @onclick="CloseMenu">Employment</a>
                <a href="/contact" @onclick="CloseMenu">Contact</a>
            </nav>
            <button class="theme-toggle" @onclick="ToggleTheme" aria-label="Toggle dark and light mode">
                @((MarkupString)(_isDark ? "&#9728;" : "&#127769;"))
            </button>
        </div>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="site-footer">
        <p>
            &copy; @DateTime.Now.Year Cole Spitzer. Built with Blazor WebAssembly.
            <a href="https://github.com/baseballr/cole-portfolio" class="link">Source</a>
        </p>
    </footer>
</div>

@code {
    private bool _menuOpen = false;
    private bool _isDark = true;

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }

    private void CloseMenu()
    {
        _menuOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var current = await JS.InvokeAsync<string>("themeInterop.getTheme");
            _isDark = current != "light";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("themeInterop.setTheme", _isDark ? "dark" : "light");
    }
}